#!/usr/bin/env python3
"""aws credential_process helper — supplies AWS credentials to SDKs remotely.

Companion to remote/aws (the CLI wrapper). AWS SDKs (boto3, aws-sdk-js, ...)
that read ~/.aws/config invoke this via a profile's `credential_process`
directive. It requests short-lived STS credentials from the credential server
over the forwarded Unix socket and prints them in the credential_process JSON
format. Credentials only live in the SDK process.

Without the forwarded socket it exits non-zero — the SDK then reports no
credentials.

Canonical copy: agentic-coding/remote/aws-credential-process. Deployment repos
vendor a byte-identical copy — keep them in sync.
"""
import json
import os
import socket
import stat
import sys
import time

SOCKET_PATH = os.environ.get(
    "CREDENTIAL_SOCKET", f"/run/user/{os.getuid()}/credential-server.sock"
)
SOCKET_WAIT = 10        # seconds to wait for the forwarded socket to appear
REQUEST_TIMEOUT = 120


def fail(message):
    """Print an error and exit non-zero — the SDK then sees no credentials."""
    sys.stderr.write(f"aws-credential-process: {message}\n")
    sys.exit(1)


def is_socket(path):
    """Return True if path exists and is a Unix socket."""
    try:
        return stat.S_ISSOCK(os.stat(path).st_mode)
    except OSError:
        return False


def request_credentials(payload):
    """Ask the credential server for creds. Returns response dict or None."""
    waited = 0
    while not is_socket(SOCKET_PATH) and waited < SOCKET_WAIT:
        time.sleep(1)
        waited += 1
    if not is_socket(SOCKET_PATH):
        fail("credential tunnel not up — reconnect to re-establish the forwarded socket")

    for attempt in range(3):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(REQUEST_TIMEOUT)
        try:
            s.connect(SOCKET_PATH)
            s.sendall(json.dumps(payload).encode() + b"\n")
            data = s.recv(8192).decode().strip()
            if not data:
                raise ConnectionResetError("empty response")
            return json.loads(data)
        except (ConnectionRefusedError, FileNotFoundError,
                BrokenPipeError, ConnectionResetError):
            # Server may have restarted — retry a couple of times.
            if attempt < 2:
                time.sleep(1)
                continue
            return None
        except (socket.timeout, json.JSONDecodeError, OSError):
            return None
        finally:
            s.close()
    return None


def cmdline(pid):
    with open(f"/proc/{pid}/cmdline", "rb") as f:
        parts = f.read().decode("utf-8", "replace").split("\0")
    return " ".join(p for p in parts if p)


def parent_pid(pid):
    with open(f"/proc/{pid}/stat") as f:
        # comm may contain spaces or parens — split after the last ')'.
        return int(f.read().rsplit(")", 1)[1].split()[1])


def invoking_command():
    """Best-effort command line of the SDK process that invoked us."""
    # SDKs spawn us via `sh -c "<credential_process>"` — skip that wrapper.
    script = os.path.basename(sys.argv[0])
    try:
        pid = os.getppid()
        while pid > 1:
            cmd = cmdline(pid)
            if script not in cmd:
                return cmd
            pid = parent_pid(pid)
    except (OSError, ValueError, IndexError):
        pass
    return ""


def main():
    if len(sys.argv) != 2:
        fail("usage: aws-credential-process <profile>")
    profile = sys.argv[1]

    response = request_credentials({
        "type": "aws",
        "profile": profile,
        "origin": "remote",
        "host": socket.gethostname(),
        "cmd": invoking_command() or f"aws-credential-process {profile}",
        "cwd": os.getcwd(),
    })

    if response is None:
        fail("credential request failed — is the credential server running?")
    if not response.get("ok"):
        fail(f"credential request denied for profile {profile}")

    access_key = response.get("access_key_id")
    secret_key = response.get("secret_access_key")
    if not (access_key and secret_key):
        fail("credential response missing keys")

    creds = {
        "Version": 1,
        "AccessKeyId": access_key,
        "SecretAccessKey": secret_key,
        "SessionToken": response.get("session_token", ""),
    }
    expiration = response.get("expiration")
    if expiration:
        creds["Expiration"] = expiration
    print(json.dumps(creds))


if __name__ == "__main__":
    main()
