#!/bin/bash
set -eu

# aws wrapper that fetches temporary credentials on-demand from credential server.
# Credentials only live in this process + the real aws process, never in the parent env.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SOCKET_PATH="${SCRIPT_DIR%/bin}/.credential-server.sock"

# Disable pager — not useful in sandbox/agent context
export AWS_PAGER=""

# Find real aws binary (skip ourselves)
REAL_AWS=""
IFS=: read -ra path_dirs <<< "$PATH"
for dir in "${path_dirs[@]}"; do
    if [[ "$dir" != "$SCRIPT_DIR" && -x "$dir/aws" ]]; then
        REAL_AWS="$dir/aws"
        break
    fi
done

if [[ -z "$REAL_AWS" ]]; then
    echo -e "\033[31mError: aws not found in PATH (looked everywhere except $SCRIPT_DIR)\033[0m" >&2
    exit 1
fi

# Extract --profile from args
PROFILE=""
ARGS=()
SKIP_NEXT=false
for arg in "$@"; do
    if $SKIP_NEXT; then
        PROFILE="$arg"
        SKIP_NEXT=false
        continue
    fi
    if [[ "$arg" == "--profile" ]]; then
        SKIP_NEXT=true
        continue
    fi
    if [[ "$arg" == --profile=* ]]; then
        PROFILE="${arg#--profile=}"
        continue
    fi
    ARGS+=("$arg")
done

# Also check AWS_PROFILE env var
if [[ -z "$PROFILE" && -n "${AWS_PROFILE:-}" ]]; then
    PROFILE="$AWS_PROFILE"
fi

# If no profile, run aws as-is
if [[ -z "$PROFILE" ]]; then
    exec "$REAL_AWS" "$@"
fi

# Request credentials from credential server (with retry while unavailable)
CREDS=$("$SCRIPT_DIR/_credential-request" "$SOCKET_PATH" "{\"type\":\"aws\",\"profile\":\"$PROFILE\"}" aws_creds) || true

if [[ -n "$CREDS" ]]; then
    # Read the three lines of credentials
    IFS=$'\n' read -rd '' AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN <<< "$CREDS" || true
    export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
    # Extract region/output from profile config (can't use --profile — triggers SSO lookup)
    AWS_CONFIG="${AWS_CONFIG_FILE:-$HOME/.aws/config}"
    if [[ -f "$AWS_CONFIG" ]]; then
        IN_PROFILE=false
        while IFS= read -r line; do
            if [[ "$line" =~ ^\[profile[[:space:]]+${PROFILE}\] ]]; then
                IN_PROFILE=true
            elif [[ "$line" =~ ^\[ ]]; then
                IN_PROFILE=false
            elif $IN_PROFILE; then
                if [[ "$line" =~ ^region[[:space:]]*=[[:space:]]*(.*) && -z "${AWS_DEFAULT_REGION:-}" ]]; then
                    export AWS_DEFAULT_REGION="${BASH_REMATCH[1]}"
                elif [[ "$line" =~ ^output[[:space:]]*=[[:space:]]*(.*) && -z "${AWS_DEFAULT_OUTPUT:-}" ]]; then
                    export AWS_DEFAULT_OUTPUT="${BASH_REMATCH[1]}"
                fi
            fi
        done < "$AWS_CONFIG"
    fi
    exec "$REAL_AWS" "${ARGS[@]}"
fi

# Denied or server error — fail closed (unauthenticated aws is useless here)
echo -e "\033[31mCredential request denied for profile $PROFILE\033[0m" >&2
exit 1
