#!/bin/bash
set -eu

# gh wrapper that fetches token on-demand from credential server.
# Token only lives in this process + the real gh process, never in the parent env.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SOCKET_PATH="${SCRIPT_DIR%/bin}/.credential-server.sock"

# Find real gh binary (skip ourselves)
REAL_GH=""
IFS=: read -ra path_dirs <<< "$PATH"
for dir in "${path_dirs[@]}"; do
    if [[ "$dir" != "$SCRIPT_DIR" && -x "$dir/gh" ]]; then
        REAL_GH="$dir/gh"
        break
    fi
done

if [[ -z "$REAL_GH" ]]; then
    echo -e "\033[31mError: gh not found in PATH (looked everywhere except $SCRIPT_DIR)\033[0m" >&2
    exit 1
fi

# Request token from credential server (with retry while server is unavailable)
GH_TOKEN=$("$SCRIPT_DIR/_credential-request" "$SOCKET_PATH" '{"type":"gh"}' gh_token) || true

if [[ -n "$GH_TOKEN" ]]; then
    export GH_TOKEN
else
    echo -e "\033[33mCredential request denied — running gh unauthenticated\033[0m" >&2
fi

exec "$REAL_GH" "$@"
