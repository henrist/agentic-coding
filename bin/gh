#!/bin/bash
set -eu

# gh wrapper that fetches token on-demand from credential server.
# Token only lives in this process + the real gh process, never in the parent env.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SOCKET_PATH="${SCRIPT_DIR%/bin}/.credential-server.sock"

# Find real gh binary (skip ourselves)
REAL_GH=""
IFS=: read -ra path_dirs <<< "$PATH"
for dir in "${path_dirs[@]}"; do
    if [[ "$dir" != "$SCRIPT_DIR" && -x "$dir/gh" ]]; then
        REAL_GH="$dir/gh"
        break
    fi
done

if [[ -z "$REAL_GH" ]]; then
    echo "Error: gh not found in PATH (looked everywhere except $SCRIPT_DIR)" >&2
    exit 1
fi

# If no socket, run gh without auth
if [[ ! -S "$SOCKET_PATH" ]]; then
    exec "$REAL_GH" "$@"
fi

# Request token from credential server (JSON protocol)
GH_TOKEN=$(python3 -c "
import json, socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
try:
    s.connect('$SOCKET_PATH')
    s.sendall(json.dumps({'type': 'gh'}).encode() + b'\n')
    data = s.recv(4096).decode().strip()
    r = json.loads(data)
    if r.get('ok') and r.get('token'):
        print(r['token'])
    else:
        sys.exit(1)
except Exception:
    sys.exit(1)
finally:
    s.close()
" 2>/dev/null) || true

if [[ -n "$GH_TOKEN" ]]; then
    export GH_TOKEN
else
    echo "Credential request denied — running gh unauthenticated" >&2
fi

exec "$REAL_GH" "$@"
