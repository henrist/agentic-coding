#!/bin/bash
set -eu

# ssh wrapper that gates SSH agent access through credential server.
# Strips SSH_AUTH_SOCK unless approved — agent signing only happens if explicitly allowed.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SOCKET_PATH="${SCRIPT_DIR%/bin}/.credential-server.sock"

# Save and strip SSH_AUTH_SOCK
ORIG_SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-}"
unset SSH_AUTH_SOCK

# Find real ssh binary (skip ourselves)
REAL_SSH=""
IFS=: read -ra path_dirs <<< "$PATH"
for dir in "${path_dirs[@]}"; do
    if [[ "$dir" != "$SCRIPT_DIR" && -x "$dir/ssh" ]]; then
        REAL_SSH="$dir/ssh"
        break
    fi
done

if [[ -z "$REAL_SSH" ]]; then
    echo -e "\033[31mError: ssh not found in PATH (looked everywhere except $SCRIPT_DIR)\033[0m" >&2
    exit 1
fi

# If no agent was available, run ssh without agent
if [[ -z "$ORIG_SSH_AUTH_SOCK" ]]; then
    exec "$REAL_SSH" "$@"
fi

# Request approval from credential server
APPROVED=$("$SCRIPT_DIR/_credential-request" "$SOCKET_PATH" '{"type":"ssh"}' approved) || true

if [[ "$APPROVED" == "yes" ]]; then
    export SSH_AUTH_SOCK="$ORIG_SSH_AUTH_SOCK"
else
    echo -e "\033[33mSSH agent access denied — running ssh without agent\033[0m" >&2
fi

exec "$REAL_SSH" "$@"
