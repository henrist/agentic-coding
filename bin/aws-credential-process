#!/bin/bash
set -eu

# AWS credential_process helper for SDK credential resolution inside sandbox.
# Called by AWS SDKs via credential_process config directive.
# Outputs JSON per https://docs.aws.amazon.com/cli/latest/userguide/cli-configure-sourcing-external.html

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SOCKET_PATH="${SCRIPT_DIR%/bin}/.credential-server.sock"
PROFILE="${1:-default}"

exec "$SCRIPT_DIR/_credential-request" "$SOCKET_PATH" \
    "{\"type\":\"aws\",\"profile\":\"$PROFILE\"}" \
    aws_credential_process
