#!/bin/bash
set -eu

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SOCKET_PATH="${SCRIPT_DIR%/bin}/.credential-server.sock"

REAL_AZ=""
IFS=: read -ra path_dirs <<< "$PATH"
for dir in "${path_dirs[@]}"; do
    if [[ "$dir" != "$SCRIPT_DIR" && -x "$dir/az" ]]; then
        REAL_AZ="$dir/az"
        break
    fi
done

if [[ -z "$REAL_AZ" ]]; then
    echo -e "\033[31mError: az not found in PATH (looked everywhere except $SCRIPT_DIR)\033[0m" >&2
    exit 1
fi

APPROVED=$("$SCRIPT_DIR/_credential-request" "$SOCKET_PATH" '{"type":"az"}' approved) || true

if [[ "$APPROVED" != "yes" ]]; then
    echo -e "\033[33mCredential request denied\033[0m" >&2
    exit 1
fi

exec "$REAL_AZ" "$@"
