#!/bin/bash
set -eu

# Git credential helper that fetches tokens from credential server.
# Called by git with "get", "store", or "erase" as argument.

# Only handle "get" — ignore store/erase
if [[ "${1:-}" != "get" ]]; then
    exit 0
fi

# Read input (protocol, host, etc.)
HOST=""
PROTOCOL=""
while IFS= read -r line; do
    [[ -z "$line" ]] && break
    case "$line" in
        host=*) HOST="${line#host=}" ;;
        protocol=*) PROTOCOL="${line#protocol=}" ;;
    esac
done

# Only handle github.com over https
if [[ "$HOST" != "github.com" || "$PROTOCOL" != "https" ]]; then
    exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SOCKET_PATH="${SCRIPT_DIR%/bin}/.credential-server.sock"

if [[ ! -S "$SOCKET_PATH" ]]; then
    exit 0
fi

# Request gh token from credential server
TOKEN=$(python3 -c "
import json, socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
try:
    s.connect('$SOCKET_PATH')
    s.sendall(json.dumps({'type': 'gh'}).encode() + b'\n')
    data = s.recv(4096).decode().strip()
    r = json.loads(data)
    if r.get('ok') and r.get('token'):
        print(r['token'])
    else:
        sys.exit(1)
except Exception:
    sys.exit(1)
finally:
    s.close()
" 2>/dev/null) || true

if [[ -z "$TOKEN" ]]; then
    echo "Credential request denied — git auth will fail" >&2
    exit 0
fi

printf 'protocol=https\nhost=github.com\nusername=x-access-token\npassword=%s\n' "$TOKEN"
