#!/bin/bash
set -eu

# Git credential helper that fetches tokens from credential server.
# Called by git with "get", "store", or "erase" as argument.

# Only handle "get" — ignore store/erase
if [[ "${1:-}" != "get" ]]; then
    exit 0
fi

# Read input (protocol, host, etc.)
HOST=""
PROTOCOL=""
while IFS= read -r line; do
    [[ -z "$line" ]] && break
    case "$line" in
        host=*) HOST="${line#host=}" ;;
        protocol=*) PROTOCOL="${line#protocol=}" ;;
    esac
done

# Only handle github.com over https
if [[ "$HOST" != "github.com" || "$PROTOCOL" != "https" ]]; then
    exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SOCKET_PATH="${SCRIPT_DIR%/bin}/.credential-server.sock"

# Request gh token from credential server (with retry while unavailable)
TOKEN=$("$SCRIPT_DIR/_credential-request" "$SOCKET_PATH" '{"type":"gh"}' gh_token) || true

if [[ -z "$TOKEN" ]]; then
    echo -e "\033[33mCredential request denied — git auth will fail\033[0m" >&2
    exit 0
fi

printf 'protocol=https\nhost=github.com\nusername=x-access-token\npassword=%s\n' "$TOKEN"
