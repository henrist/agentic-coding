#!/usr/bin/env python3
"""Shared credential request helper with retry logic.

Usage: _credential-request <socket_path> <json_payload> [mode]

Mode values:
  - json (default): print full response JSON
  - gh_token: print GitHub token
  - aws_creds: print access key, secret key, session token (3 lines)
  - approved: print "yes"

Exits 0 on success, 1 on denial/error.

Retry behavior:
  - If socket missing: wait up to ~3 min, polling with backoff
  - If connection drops mid-request: retry immediately (server may have restarted)
  - Terminal bell on first wait to alert user
  - Stderr messages for visibility
"""
import json
import os
import socket
import stat
import sys
import time

INITIAL_INTERVAL = 2
MAX_INTERVAL = 10
MAX_WAIT = 180  # 3 minutes
REQUEST_TIMEOUT = 120
REPO_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

RED = "\033[31m"
YELLOW = "\033[33m"
GREEN = "\033[32m"
DIM = "\033[2m"
RESET = "\033[0m"


def stderr(message):
    """Write one stderr line and flush."""
    sys.stderr.write(message + "\n")
    sys.stderr.flush()


def request_credential(socket_path, payload):
    """Connect to socket, send payload, return parsed JSON response."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(REQUEST_TIMEOUT)
    try:
        s.connect(socket_path)
        s.sendall(json.dumps(payload).encode() + b'\n')
        data = s.recv(8192).decode().strip()
        if not data:
            raise ConnectionResetError("empty response")
        return json.loads(data)
    finally:
        s.close()


def is_socket(path):
    """Return True if path exists and is a UNIX socket."""
    try:
        return stat.S_ISSOCK(os.stat(path).st_mode)
    except OSError:
        return False


def wait_for_socket(socket_path):
    """Wait for socket to appear, with backoff and bell."""
    if is_socket(socket_path):
        return True

    # Terminal bell + stderr message on first wait
    stderr(f'\a{YELLOW}Credential server not running - waiting for it to start...{RESET}')
    stderr(f'{DIM}Start it: {REPO_DIR}/credential-server{RESET}')

    elapsed = 0
    interval = INITIAL_INTERVAL
    while elapsed < MAX_WAIT:
        time.sleep(interval)
        elapsed += interval
        if is_socket(socket_path):
            stderr(f'{GREEN}Credential server detected{RESET}')
            return True
        interval = min(interval * 1.5, MAX_INTERVAL)

    stderr(f'{RED}Timed out waiting for credential server{RESET}')
    return False


def output_mode(mode, response):
    """Print mode-specific output from successful response."""
    if mode == "gh_token":
        token = response.get("token")
        if token:
            print(token)
            return
        raise KeyError("token")

    if mode == "aws_creds":
        access_key_id = response.get("access_key_id")
        secret_access_key = response.get("secret_access_key")
        if access_key_id and secret_access_key:
            print(access_key_id)
            print(secret_access_key)
            print(response.get("session_token", ""))
            return
        raise KeyError("aws credentials")

    if mode == "approved":
        print("yes")
        return

    raise ValueError(mode)


def main():
    if len(sys.argv) != 4:
        stderr(f'{RED}Usage: _credential-request <socket_path> <json_payload> <mode>{RESET}')
        sys.exit(1)

    socket_path = sys.argv[1]
    try:
        payload = json.loads(sys.argv[2])
    except json.JSONDecodeError as e:
        stderr(f'{RED}Invalid JSON payload: {e}{RESET}')
        sys.exit(1)
    mode = sys.argv[3]

    max_retries = 3
    for attempt in range(max_retries):
        if not wait_for_socket(socket_path):
            sys.exit(1)

        try:
            response = request_credential(socket_path, payload)
            if not response.get('ok'):
                sys.exit(1)
            output_mode(mode, response)
            sys.exit(0)
        except (ConnectionRefusedError, FileNotFoundError, BrokenPipeError, ConnectionResetError):
            # Server went away - retry (it may restart)
            if attempt < max_retries - 1:
                stderr(f'{YELLOW}Credential server disconnected - retrying...{RESET}')
                time.sleep(1)
                continue
            sys.exit(1)
        except socket.timeout:
            stderr(f'{RED}Credential request timed out{RESET}')
            sys.exit(1)
        except KeyError:
            stderr(f'{RED}Credential response missing expected fields{RESET}')
            sys.exit(1)
        except ValueError:
            stderr(f'{RED}Invalid output mode: {mode}{RESET}')
            sys.exit(1)
        except (json.JSONDecodeError, OSError) as e:
            stderr(f'{RED}Credential request failed: {e}{RESET}')
            sys.exit(1)

    sys.exit(1)


if __name__ == '__main__':
    main()
