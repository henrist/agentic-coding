def get_process_chain(pid, max_depth=16):
    """Walk the process tree up from pid."""
    chain = []
    current = pid
    for _ in range(max_depth):
        if current <= 1:
            break
        try:
            out = subprocess.check_output(
                ["ps", "-p", str(current), "-o", "pid=,ppid=,args="],
                stderr=subprocess.DEVNULL,
            ).decode().strip()
            parts = out.split(None, 2)
            if len(parts) < 3:
                break
            args = parts[2]
            name = os.path.basename(args.split()[0]) if args else "?"
            chain.append((int(parts[0]), name, args))
            current = int(parts[1])
        except (subprocess.CalledProcessError, ValueError):
            break
    return chain


def get_cwd(pid):
    """Get working directory of a process."""
    try:
        out = subprocess.check_output(
            ["lsof", "-a", "-d", "cwd", "-p", str(pid), "-Fn"],
            stderr=subprocess.DEVNULL,
        ).decode()
        return next((l[1:] for l in out.splitlines() if l.startswith("n/")), None)
    except subprocess.CalledProcessError:
        return None


def parse_chain(chain):
    """Extract command and safehouse info from process chain."""
    cmd = None
    cmd_pid = None
    ssh_fallback = None
    safehouse_pid = None
    safehouse_cwd = None
    for pid, name, args in chain:
        if ".credential-server.sock" in args:
            continue
        if "git-credential-helper" in args:
            continue
        if "libexec/git-core/" in args:
            continue
        if "aws-credential-process" in args:
            continue
        if "safehouse" in args:
            safehouse_pid = pid
            safehouse_cwd = get_cwd(pid)
            break
        # First non-skipped entry is the actual command
        if cmd is None:
            for wrapper in ("bin/gh", "bin/aws", "bin/ssh"):
                if wrapper in args:
                    parts = args.split(wrapper, 1)
                    tool = wrapper.split("/")[1]
                    extracted = f"{tool}{parts[1]}" if len(parts) > 1 else tool
                    if wrapper == "bin/ssh":
                        # Don't set cmd yet — look for parent (e.g. git)
                        ssh_fallback = extracted
                    else:
                        cmd = extracted
                        cmd_pid = pid
                    break
            else:
                if ssh_fallback is not None:
                    # Walk past intermediate processes to find primary git command
                    if name == "git" or args.split()[0].endswith("/git"):
                        git_parts = args.split()
                        gi = 1
                        while gi < len(git_parts) - 1 and git_parts[gi] == "-c":
                            gi += 2
                        if gi < len(git_parts) and git_parts[gi] in (
                            "push", "fetch", "pull", "clone", "ls-remote",
                        ):
                            cmd = args
                            cmd_pid = pid
                    # else: keep walking past git-lfs, hooks, etc.
                else:
                    cmd = args
                    cmd_pid = pid
    actual_cmd = ssh_fallback if ssh_fallback and cmd else None
    if cmd is None and ssh_fallback is not None:
        cmd = ssh_fallback
    if cmd:
        cmd = " ".join(cmd.split())
    if actual_cmd:
        actual_cmd = " ".join(actual_cmd.split())
    return cmd, cmd_pid, safehouse_pid, safehouse_cwd, actual_cmd


def cmd_pattern(cmd):
    """Extract command pattern for grouping similar commands."""
    parts = cmd.split()
    if len(parts) >= 3 and parts[0] in ("aws", "gh"):
        return " ".join(parts[:3])
    if len(parts) >= 2:
        return " ".join(parts[:2])
    return cmd


def check_approval(safehouse_pid, cred_key, cmd):
    """Check if pre-approved. Returns (approved, reason)."""
    key = (safehouse_pid, cred_key)
    if safehouse_pid is None or key not in approvals:
        return False, None
    entry = approvals[key]

    # Check expiry
    if entry["expires"] is not None:
        remaining = (entry["expires"] - datetime.now()).total_seconds()
        if remaining <= 0:
            del approvals[key]
            save_approvals()
            return False, None
        mins, secs = divmod(int(remaining), 60)
        time_left = f"{mins}m{secs:02d}s"
    else:
        try:
            os.kill(safehouse_pid, 0)
            time_left = "sess"
        except ProcessLookupError:
            del approvals[key]
            save_approvals()
            return False, None

    mode = entry.get("mode", "all")

    if mode == "all":
        return True, time_left

    is_read = is_read_only(cmd)

    if mode == "read":
        if is_read:
            return True, f"read {time_left}"
        return False, None

    if mode == "similar":
        if is_read:
            return True, f"read {time_left}"
        if cmd_pattern(cmd) == entry.get("pattern"):
            return True, f"{entry['pattern']} {time_left}"
        return False, None

    return False, None


def store_approval(safehouse_pid, cred_key, mode, duration, cmd=None):
    """Store approval decision. mode: read/similar/all, duration: 1/5/session."""
    if safehouse_pid is None:
        return
    key = (safehouse_pid, cred_key)
    durations = {"1": timedelta(minutes=1), "5": timedelta(minutes=5)}
    expires = datetime.now() + durations[duration] if duration in durations else None
    entry = {"mode": mode, "expires": expires}
    if mode == "similar" and cmd:
        entry["pattern"] = cmd_pattern(cmd)
    approvals[key] = entry
    save_approvals()


def save_approvals():
    """Persist current approvals to .approvals.toml."""
    entries = []
    now = datetime.now()
    for (pid, cred_key), entry in list(approvals.items()):
        # Skip already-expired entries
        if entry["expires"] is not None and entry["expires"] <= now:
            continue
        rec = {"safehouse_pid": pid, "cred_key": cred_key, "mode": entry["mode"]}
        if entry["expires"] is not None:
            rec["expires"] = entry["expires"].strftime("%Y-%m-%dT%H:%M:%S")
        if "pattern" in entry:
            rec["pattern"] = entry["pattern"]
        if entry.get("sensitive"):
            rec["sensitive"] = True
        entries.append(rec)
    lines = ["# Auto-managed by credential-server. Edit at your own risk.", ""]
    for rec in entries:
        lines.append("[[approvals]]")
        for k, v in rec.items():
            if isinstance(v, bool):
                lines.append(f"{k} = {str(v).lower()}")
            elif isinstance(v, int):
                lines.append(f"{k} = {v}")
            else:
                lines.append(f'{k} = "{v}"')
        lines.append("")
    try:
        with open(APPROVALS_PATH, "w") as f:
            f.write("\n".join(lines))
    except OSError as e:
        print(f"  {RED}warning: failed to save approvals: {e}{RESET}")


def load_approvals():
    """Load approvals from .approvals.toml. Prunes expired and dead-PID entries."""
    if tomllib is None or not os.path.exists(APPROVALS_PATH):
        return {}
    try:
        with open(APPROVALS_PATH, "rb") as f:
            data = tomllib.load(f)
    except (tomllib.TOMLDecodeError, OSError) as e:
        print(f"  {RED}warning: failed to load approvals: {e}{RESET}")
        return {}
    now = datetime.now()
    result = {}
    for rec in data.get("approvals", []):
        pid = rec.get("safehouse_pid")
        cred_key = rec.get("cred_key")
        if not pid or not cred_key:
            continue
        # Check PID still alive
        if not _pid_alive(pid):
            continue
        # Check expiry
        expires = None
        if "expires" in rec:
            try:
                expires = datetime.strptime(rec["expires"], "%Y-%m-%dT%H:%M:%S")
            except ValueError:
                continue
            if expires <= now:
                continue
        entry = {"mode": rec.get("mode", "all"), "expires": expires}
        if "pattern" in rec:
            entry["pattern"] = rec["pattern"]
        if rec.get("sensitive"):
            entry["sensitive"] = True
        result[(pid, cred_key)] = entry
    return result

def read_key(timeout=None):
    """Read a single keypress without requiring Enter. Returns None on timeout."""
    fd = sys.stdin.fileno()
    if os.isatty(fd):
        old = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            if timeout is not None:
                ready, _, _ = select.select([fd], [], [], timeout)
                if not ready:
                    return None
            ch = sys.stdin.read(1)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        return ch
    else:
        # Fallback for non-TTY (testing)
        line = sys.stdin.readline()
        return line[0] if line else "d"


def prompt_duration(mode_label, timeout=30):
    """Prompt for duration after mode selection. Returns '1'/'5'/'s' or None on cancel/timeout."""
    sys.stdout.write(f"  {mode_label} {DIM}[1]{RESET}min  {DIM}[5]{RESET}min  {DIM}[s]{RESET}ession ▸ ")
    sys.stdout.flush()
    deadline = time.monotonic() + timeout
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            print(f"{RED}timed out{RESET}")
            return None
        ch = read_key(timeout=min(remaining, 1.0))
        if ch is None:
            continue
        if ch == "\x03":
            print()
            cleanup()
        elif ch == "\x1b" or ch in ("d", "D"):
            print(f"{RED}cancelled{RESET}")
            return None
        elif ch == "1":
            print(f"{GREEN}1 min{RESET}")
            return "1"
        elif ch == "5":
            print(f"{GREEN}5 min{RESET}")
            return "5"
        elif ch in ("s", "S"):
            print(f"{GREEN}session{RESET}")
            return "session"


def _print_chain_debug(chain):
    """Print process chain for debugging approval decisions."""
    print(f"  {DIM}--- process chain (child -> parent) ---{RESET}")
    for i, (pid, name, args) in enumerate(chain):
        # Tag known process types
        tags = []
        if name == "claude":
            tags.append(f"{CYAN}claude-code{RESET}")
        elif name == "opencode":
            tags.append(f"{CYAN}opencode{RESET}")
        elif "safehouse" in args:
            tags.append(f"{GREEN}sandbox{RESET}")
        elif name == "git" or args.split()[0].endswith("/git"):
            tags.append("git")
        elif name in ("node", "python3", "bash", "zsh", "sh"):
            tags.append(name)
        for wrapper in ("bin/gh", "bin/aws", "bin/ssh"):
            if wrapper in args:
                tags.append(f"{CYAN}wrapper{RESET}")
                break
        tag_str = f" {DIM}({', '.join(tags)}){RESET}" if tags else ""
        indent = "    " + "  " * i
        # Truncate long args
        display_args = args if len(args) <= 120 else args[:117] + "..."
        print(f"{indent}{DIM}pid={pid}{RESET} {BOLD}{name}{RESET}{tag_str}")
        print(f"{indent}  {DIM}{display_args}{RESET}")
    print(f"  {DIM}---{RESET}")

def prompt_approval(cmd, chain=()):
    """Two-step approval: mode then duration. Returns (action, mode, duration) tuple.
    action: 'once'/'deny'/'approve'
    mode: 'read'/'similar'/'all' (only for 'approve')
    duration: '1'/'5'/'session' (only for 'approve')
    """
    is_write = not is_read_only(cmd)
    pattern = cmd_pattern(cmd) if is_write else None

    debug_hint = f"  {DIM}[?]{RESET}info" if chain else ""
    if pattern:
        prompt_line = f"  {DIM}[Enter]{RESET}once  {DIM}[d]{RESET}eny  {DIM}[r]{RESET}eads  {DIM}[p]{RESET} {CYAN}{pattern}{RESET}+reads  {DIM}[a]{RESET}ll{debug_hint} \u25b8 "
    else:
        prompt_line = f"  {DIM}[Enter]{RESET}once  {DIM}[d]{RESET}eny  {DIM}[r]{RESET}eads  {DIM}[a]{RESET}ll{debug_hint} \u25b8 "
    sys.stdout.write(prompt_line)
    sys.stdout.flush()
    deadline = time.monotonic() + PROMPT_TIMEOUT
    next_reminder = time.monotonic() + REMINDER_INTERVAL
    while True:
        now = time.monotonic()
        remaining = deadline - now
        if remaining <= 0:
            print(f"{RED}timed out{RESET}")
            return "deny", None, None
        if now >= next_reminder:
            notify(cmd)
            next_reminder = now + REMINDER_INTERVAL
        wait = min(remaining, next_reminder - time.monotonic())
        ch = read_key(timeout=max(0.1, wait))
        if ch is None:
            continue
        if ch == "?" and chain:
            print()
            _print_chain_debug(chain)
            sys.stdout.write(prompt_line)
            sys.stdout.flush()
            continue
        if ch == "\x03":  # Ctrl+C
            print()
            cleanup()
        elif ch == "\x1b":  # Esc
            print(f"{RED}denied{RESET}")
            return "deny", None, None
        elif ch in ("d", "D"):
            print(f"{RED}denied{RESET}")
            return "deny", None, None
        elif ch in ("\r", "\n"):
            print(f"{GREEN}once{RESET}")
            return "once", None, None
        elif ch in ("r", "R"):
            sys.stdout.write(f"{GREEN}reads{RESET}\n")
            dur = prompt_duration("reads")
            if dur is None:
                return "deny", None, None
            return "approve", "read", dur
        elif ch in ("p", "P") and pattern:
            sys.stdout.write(f"{GREEN}{pattern}+reads{RESET}\n")
            dur = prompt_duration(f"{pattern}+reads")
            if dur is None:
                return "deny", None, None
            return "approve", "similar", dur
        elif ch in ("a", "A"):
            sys.stdout.write(f"{GREEN}all{RESET}\n")
            dur = prompt_duration("all")
            if dur is None:
                return "deny", None, None
            return "approve", "all", dur


def prompt_sensitive(cmd=None):
    """Prompt for sensitive command escalation. Returns 'once'/'deny'/'remember'."""
    sys.stdout.write(f"  {DIM}[Enter]{RESET}once  {DIM}[d]{RESET}eny  {DIM}[r]{RESET}emember ▸ ")
    sys.stdout.flush()
    deadline = time.monotonic() + PROMPT_TIMEOUT
    next_reminder = time.monotonic() + REMINDER_INTERVAL
    while True:
        now = time.monotonic()
        remaining = deadline - now
        if remaining <= 0:
            print(f"{RED}timed out{RESET}")
            return "deny"
        if now >= next_reminder:
            if cmd:
                notify(cmd)
            next_reminder = now + REMINDER_INTERVAL
        wait = min(remaining, next_reminder - time.monotonic())
        ch = read_key(timeout=max(0.1, wait))
        if ch is None:
            continue
        if ch == "\x03":
            print()
            cleanup()
        elif ch == "\x1b" or ch in ("d", "D"):
            print(f"{RED}denied{RESET}")
            return "deny"
        elif ch in ("\r", "\n"):
            print(f"{GREEN}once{RESET}")
            return "once"
        elif ch in ("r", "R"):
            print(f"{GREEN}remember{RESET}")
            return "remember"


def fetch_gh_token():
    """Fetch gh auth token. Returns token string or None."""
    try:
        return subprocess.check_output(
            ["gh", "auth", "token"], stderr=subprocess.DEVNULL
        ).decode().strip()
    except subprocess.CalledProcessError:
        return None


# AWS credential cache: {profile: {"creds": {...}, "expires": datetime}}
aws_cache = {}


def fetch_aws_credentials(profile):
    """Fetch temporary AWS credentials for profile, with caching. Returns dict or None."""
    # Check cache
    if profile in aws_cache:
        entry = aws_cache[profile]
        remaining = (entry["expires"] - datetime.now()).total_seconds()
        # Use cache if >60s remaining
        if remaining > 60:
            return entry["creds"]
        del aws_cache[profile]

    try:
        out = subprocess.check_output(
            ["aws", "configure", "export-credentials", "--profile", profile],
            stderr=subprocess.DEVNULL,
        ).decode()
        data = json.loads(out)
        creds = {
            "access_key_id": data["AccessKeyId"],
            "secret_access_key": data["SecretAccessKey"],
            "session_token": data.get("SessionToken", ""),
            "expiration": data.get("Expiration", ""),
        }
        # Cache until expiration
        if "Expiration" in data:
            expires_utc = datetime.fromisoformat(data["Expiration"].replace("Z", "+00:00"))
            expires_local = expires_utc.astimezone().replace(tzinfo=None)
            aws_cache[profile] = {"creds": creds, "expires": expires_local}
        return creds
    except (subprocess.CalledProcessError, json.JSONDecodeError, KeyError) as e:
        print(f"  {RED}error: failed to get AWS credentials for {profile}: {e}{RESET}")
        return None


def handle_request(conn, request, safehouse_pid, safehouse_cwd, cmd, cmd_pid=None, chain=(), actual_cmd=None):
    """Handle a credential request. Returns response dict."""
    global approved_pids
    req_type = request.get("type")
    if safehouse_cwd:
        session_label = f"{CYAN}{safehouse_cwd}{RESET}  {DIM}safehouse/{safehouse_pid}{RESET}"
    elif safehouse_pid:
        session_label = f"safehouse/{safehouse_pid}"
    else:
        session_label = "unknown"

    git_branch = None
    if req_type == "gh":
        cred_key = "gh"
        detail = ""
    elif req_type == "aws":
        profile = request.get("profile", "default")
        cred_key = f"aws:{profile}"
        detail = f"\n  profile: {CYAN}{profile}{RESET}"
    elif req_type == "az":
        cred_key = "az"
        detail = ""
    elif req_type == "ssh":
        cred_key = "ssh"
        detail = ""
    else:
        return {"ok": False}

    # Resolve git branch for git/gh commands (any credential type)
    cmd_parts = cmd.split() if cmd else []
    if cmd_parts and (cmd_parts[0] in ("git", "gh") or cmd_parts[0].endswith("/git")):
        git_branch = get_git_branch(safehouse_cwd)
        if git_branch:
            detail = f"\n  branch: {CYAN}{git_branch}{RESET}"

    # Check pre-approval
    key = (safehouse_pid, cred_key)
    approved, reason = check_approval(safehouse_pid, cred_key, cmd)
    if approved:
        # Sensitive commands need additional escalation even when auto-approved
        if is_sensitive(cmd) and not approvals.get(key, {}).get("sensitive"):
            try:
                conn.getpeername()
            except OSError:
                print(f"  {DIM}skipped (disconnected): {cmd}{RESET}")
                return {"ok": False}
            notify(cmd)
            print(f"\n  {session_label}")
            print(f"  {BOLD}⚠ sensitive:{RESET} {RED}{cmd}{RESET}")
            print(f"  {DIM}approved: {reason}{RESET}")
            sensitive_choice = prompt_sensitive(cmd)
            if sensitive_choice == "deny":
                audit_log(cmd, cred_key, "sensitive:denied", safehouse_cwd)
                return {"ok": False}
            if sensitive_choice == "remember" and key in approvals:
                approvals[key]["sensitive"] = True
                save_approvals()
            audit_log(cmd, cred_key, f"sensitive:{sensitive_choice}", safehouse_cwd)
        else:
            tags = [reason]
            if is_sensitive(cmd):
                tags.append("sensitive")
            if is_read_only(cmd):
                tags.append("read")
            if req_type == "aws":
                tags.insert(0, request.get("profile", "default"))
            if git_branch:
                tags.append(f"branch:{git_branch}")
            cwd_short = os.path.basename(safehouse_cwd) if safehouse_cwd else ""
            if cwd_short:
                tags.append(cwd_short)
            print(f"\n  {GREEN}\u2713{RESET} {DIM}({', '.join(tags)}){RESET}\n    {cmd}")
            audit_log(cmd, cred_key, reason, safehouse_cwd)
        creds = _fetch_creds(req_type, request)
        if creds is not None:
            return {"ok": True, **creds}
        return {"ok": False}


    # Auto-approve git/gh reads and safe pushes
    auto_reason = None
    if auto_approve_git_reads and is_git_gh_read(cmd):
        auto_reason = "read"
    elif cmd and cmd.startswith("gh auth token") and is_claude_code(chain):
        auto_reason = "claude-auth"
    elif auto_approve_git_push and is_safe_git_push(cmd, safehouse_cwd):
        auto_reason = "push"

    # Check if any ancestor process was already approved
    if auto_reason is None and approved_pids:
        chain_pids = {pid for pid, _, _ in chain}
        matched = chain_pids & approved_pids
        if matched:
            # Clean up dead PIDs while we're here
            approved_pids -= {p for p in matched if not _pid_alive(p)}
            if chain_pids & approved_pids:
                auto_reason = "child"

    if auto_reason:
        creds = _fetch_creds(req_type, request)
        if creds is not None:
            if cmd_pid:
                approved_pids.add(cmd_pid)
            tag = f"auto, {auto_reason}, branch:{git_branch}" if git_branch else f"auto, {auto_reason}"
            display = f"{actual_cmd}\n    {DIM}via: {cmd}{RESET}" if actual_cmd else cmd
            print(f"\n  {GREEN}\u2713{RESET} {DIM}({tag}){RESET}\n    {display}")
            audit_log(cmd, cred_key, f"auto-{auto_reason}", safehouse_cwd)
            return {"ok": True, **creds}

    # Auto-approve configured AWS profiles
    if req_type == "aws":
        profile = request.get("profile", "default")
        if profile in auto_approve_aws_profiles:
            creds = _fetch_creds(req_type, request)
            if creds is not None:
                print(f"\n  {GREEN}\u2713{RESET} {DIM}(auto, config, {profile}){RESET}\n    {cmd}")
                audit_log(cmd, cred_key, "auto-config", safehouse_cwd)
                return {"ok": True, **creds}

    # Skip if caller already disconnected (queued requests)
    try:
        conn.getpeername()
    except OSError:
        print(f"  {DIM}skipped (disconnected): {cmd}{RESET}")
        return {"ok": False}

    notify(cmd)
    is_read = is_read_only(cmd)
    if is_read:
        cmd_display = f"{BOLD}{cmd}{RESET} {DIM}(read){RESET}"
    else:
        cmd_display = f"{RED}{BOLD}{cmd}{RESET} {DIM}(write){RESET}"
    print(f"\n  {session_label}")
    print(f"  {cmd_display}{detail}")
    action, mode, duration = prompt_approval(cmd, chain)

    if action == "deny":
        return {"ok": False}

    creds = _fetch_creds(req_type, request)
    if creds is None:
        return {"ok": False}

    if action == "approve":
        store_approval(safehouse_pid, cred_key, mode, duration, cmd)

    if cmd_pid:
        approved_pids.add(cmd_pid)

    audit_log(cmd, cred_key, f"{action}:{mode}:{duration}" if mode else action, safehouse_cwd)
    return {"ok": True, **creds}


def _fetch_creds(req_type, request):
    """Fetch credentials based on request type."""
    if req_type == "gh":
        token = fetch_gh_token()
        return {"token": token} if token else None
    elif req_type == "aws":
        return fetch_aws_credentials(request.get("profile", "default"))
    elif req_type == "az":
        return {}
    elif req_type == "ssh":
        return {}
    return None


