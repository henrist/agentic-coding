                safehouse_cwd = request.get("cwd") or None
                cmd_pid = None
                actual_cmd = None
                chain = ()

            # Handle
            response = handle_request(conn, request, safehouse_pid, safehouse_cwd, cmd, cmd_argv, cmd_pid, chain, actual_cmd)
            conn.sendall(json.dumps(response).encode() + b"\n")

        except (json.JSONDecodeError, EOFError, OSError):
