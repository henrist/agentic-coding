                continue
            request = json.loads(data)

            # Get process info
            peer_pid = struct.unpack("i", conn.getsockopt(SOL_LOCAL, LOCAL_PEERPID, 4))[0]
            chain = get_process_chain(peer_pid)
            cmd, cmd_argv, cmd_pid, safehouse_pid, safehouse_cwd, actual_cmd = parse_chain(chain)
