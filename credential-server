_libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
# macOS sysctl mib: CTL_KERN=1, KERN_PROCARGS2=49. Returns int32 argc, exec_path,
# optional alignment padding, then argv[0..argc-1], then envp, then applep.
_KERN_PROCARGS2 = 49
_CTL_KERN = 1


def get_argv(pid):
    """Get real argv via KERN_PROCARGS2. Returns list[str] or None if unavailable.

    Unlike `ps -o args=`, this preserves the original token boundaries: a
    `-c key="val with spaces"` flag stays a single argv element instead of being
    re-split on whitespace.
    """
    try:
        mib = (ctypes.c_int * 3)(_CTL_KERN, _KERN_PROCARGS2, pid)
        size = ctypes.c_size_t(0)
        if _libc.sysctl(mib, 3, None, ctypes.byref(size), None, 0) != 0:
            return None
        buf = (ctypes.c_char * size.value)()
        if _libc.sysctl(mib, 3, buf, ctypes.byref(size), None, 0) != 0:
            return None
        data = buf.raw[:size.value]
        if len(data) < 4:
            return None
        argc = int.from_bytes(data[:4], "little")
        # Skip exec_path (null-terminated) and any zero-padding before argv[0].
        nul = data.find(b"\x00", 4)
        if nul == -1:
            return None
        offset = nul + 1
        while offset < len(data) and data[offset] == 0:
            offset += 1
        argv = []
        for _ in range(argc):
            nul = data.find(b"\x00", offset)
            if nul == -1:
                return None
            argv.append(data[offset:nul].decode("utf-8", "replace"))
            offset = nul + 1
        return argv
    except OSError:
        return None


def get_process_chain(pid, max_depth=16):
    """Walk the process tree up from pid.

    Each entry: (pid, name, args, argv). `args` is the ps display string (lossy
    for quoted values with spaces). `argv` is the real argv list; use it for
    parsing decisions, and `args` for display only. Falls back to args.split()
    when argv is unavailable (process exited, etc.)."""
    chain = []
    current = pid
    for _ in range(max_depth):
        if current <= 1:
            break
        try:
            out = subprocess.check_output(
                ["ps", "-p", str(current), "-o", "pid=,ppid=,args="],
                stderr=subprocess.DEVNULL,
            ).decode().strip()
            parts = out.split(None, 2)
            if len(parts) < 3:
                break
            args = parts[2]
            name = os.path.basename(args.split()[0]) if args else "?"
            argv = get_argv(int(parts[0]))
            if argv is None:
                argv = args.split()
            chain.append((int(parts[0]), name, args, argv))
            current = int(parts[1])
        except (subprocess.CalledProcessError, ValueError):
            break
    return chain


def get_cwd(pid):
    """Get working directory of a process."""
    try:
        out = subprocess.check_output(
            ["lsof", "-a", "-d", "cwd", "-p", str(pid), "-Fn"],
            stderr=subprocess.DEVNULL,
        ).decode()
        return next((l[1:] for l in out.splitlines() if l.startswith("n/")), None)
    except subprocess.CalledProcessError:
        return None


def _find_wrapper(argv, wrapper):
    """Return index of an argv token whose path ends with `wrapper` (e.g. 'bin/gh')."""
    for i, tok in enumerate(argv or ()):
        if tok.endswith("/" + wrapper) or tok == wrapper:
            return i
    return None


def parse_chain(chain):
    """Extract command and safehouse info from process chain.

    Returns (cmd, cmd_argv, cmd_pid, safehouse_pid, safehouse_cwd, actual_cmd).
    `cmd`/`actual_cmd` are display strings; `cmd_argv` is the canonical
    tokenized argv. Pass it to classifiers, not cmd.split().
    """
    cmd = None
    cmd_argv = None
    cmd_pid = None
    ssh_fallback = None
    ssh_fallback_argv = None
    safehouse_pid = None
    safehouse_cwd = None
    # Outermost ansible ancestor (workers may match too via fork-inherited argv;
    # we want the long-lived top-level so approval inheritance survives worker churn).
    ansible_match = None
    for pid, name, args, argv in chain:
        if ".credential-server.sock" in args:
            continue
        if "git-credential-helper" in args:
            continue
        if "libexec/git-core/" in args:
            continue
        if "aws-credential-process" in args:
            continue
        if "safehouse" in args:
            safehouse_pid = pid
            safehouse_cwd = get_cwd(pid)
            break
        # ansible/ansible-playbook is a python script, so argv[0] may be the
        # interpreter and argv[1] the script path. Track outermost match.
        if ssh_fallback is not None and argv:
            for i, token in enumerate(argv[:2]):
                base = os.path.basename(token)
                if base in ("ansible-playbook", "ansible"):
                    new_argv = [base] + argv[i + 1:]
                    ansible_match = (shlex.join(new_argv), new_argv, pid)
                    break
        # First non-skipped entry is the actual command
        if cmd is None:
            for wrapper in ("bin/gh", "bin/aws", "bin/ssh", "bin/docker"):
                idx = _find_wrapper(argv, wrapper)
                if idx is None:
                    continue
                tool = wrapper.split("/")[1]
                new_argv = [tool] + argv[idx + 1:]
                extracted = shlex.join(new_argv)
                if wrapper == "bin/ssh":
                    # Don't set cmd yet, look for parent (e.g. git)
                    ssh_fallback = extracted
                    ssh_fallback_argv = new_argv
                else:
                    cmd = extracted
                    cmd_argv = new_argv
                    cmd_pid = pid
                break
            else:
                if ssh_fallback is not None:
                    # ssh under git: attribute to the parent git command.
                    # Otherwise keep walking past intermediates (git-lfs, hooks, sh -c, etc.)
                    is_git = argv and (argv[0] == "git" or argv[0].endswith("/git"))
                    if is_git:
                        gi = _git_subcommand_index(argv)
                        if gi is not None and argv[gi] in (
                            "push", "fetch", "pull", "clone", "ls-remote",
                        ):
                            cmd = shlex.join(argv)
                            cmd_argv = list(argv)
                            cmd_pid = pid
                else:
                    cmd_argv = list(argv) if argv else args.split()
                    cmd = shlex.join(cmd_argv)
                    cmd_pid = pid
    if cmd is None and ansible_match is not None:
        cmd, cmd_argv, cmd_pid = ansible_match
    actual_cmd = ssh_fallback if ssh_fallback and cmd else None
    if cmd is None and ssh_fallback is not None:
        cmd = ssh_fallback
        cmd_argv = ssh_fallback_argv
    return cmd, cmd_argv, cmd_pid, safehouse_pid, safehouse_cwd, actual_cmd


def _sanitize_host(host):
    """Clamp a self-reported remote host label to a safe, short token.

    Remote requests supply their own host name; restrict it so it can't
    inject ANSI codes or newlines into the scope key, prompt, or audit log."""
    cleaned = re.sub(r"[^A-Za-z0-9._-]", "", host)[:64]
    return cleaned or "unknown"


def loopback_callback_port(url):
    """Port of a loopback redirect_uri in an OAuth authorize URL, else None."""
    try:
        params = urllib.parse.parse_qs(urllib.parse.urlparse(url).query)
        for value in params.get("redirect_uri", []):
            parsed = urllib.parse.urlparse(value)
            if parsed.hostname in ("127.0.0.1", "localhost", "::1") and parsed.port:
                return parsed.port
    except ValueError:
        pass
    return None


def _cancel_forward(host, spec):
    """Tear down a forward set up by forward_loopback."""
    try:
        subprocess.run(["ssh", "-O", "cancel", "-L", spec, host],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=10)
    except (subprocess.TimeoutExpired, OSError):
        pass


def forward_loopback(host, port):
    """Tunnel localhost:<port> to the same port on host, cancelled after a TTL.

    An OAuth authorize URL from a remote host redirects to a loopback listener
    that lives on that host, but we open the URL in the Mac's browser — without
    this forward the callback lands on the Mac's own (empty) port. Needs the
    shared ssh ControlMaster to be up; if it isn't, print the manual command."""
    spec = f"{port}:127.0.0.1:{port}"
    try:
        result = subprocess.run(["ssh", "-O", "forward", "-L", spec, host],
                                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                stderr=subprocess.PIPE, timeout=10)
    except (subprocess.TimeoutExpired, OSError) as e:
        result = None
        error = str(e)
    else:
        error = result.stderr.decode(errors="replace").strip()
    if result is None or result.returncode != 0:
        print(f"  {RED}callback tunnel failed:{RESET} {error}")
        print(f"  {DIM}run manually: ssh -L {spec} {host}{RESET}")
        return
    mins = LOOPBACK_TUNNEL_TTL // 60
    print(f"  {GREEN}callback tunnel{RESET} {DIM}localhost:{port} → {host} "
          f"(cancels in {mins}min){RESET}")
    timer = threading.Timer(LOOPBACK_TUNNEL_TTL, _cancel_forward, args=(host, spec))
    timer.daemon = True
    timer.start()


# ssh flags that take a separate value argument (vs boolean or attached -pVAL form)
SSH_ARG_FLAGS = {"-B", "-b", "-c", "-D", "-E", "-e", "-F", "-I", "-i", "-J", "-L",
                 "-l", "-m", "-O", "-o", "-p", "-Q", "-R", "-S", "-W", "-w"}


def _ssh_host(parts):
    """Find destination host token in an ssh argv (skipping flag/value pairs)."""
    i = 1  # skip "ssh"
    while i < len(parts):
        tok = parts[i]
        if not tok.startswith("-"):
            return tok
        if tok in SSH_ARG_FLAGS:
            i += 2  # bare arg-flag consumes next token as its value
        else:
            i += 1  # boolean flag or attached form (e.g. -p22, -oKey=val)
    return None


def pattern_options(parts):
    """Pattern granularities for parts, recommended-first. Empty if too short."""
    if not parts:
        return []
    program = parts[0]
    options = []
    if program == "ssh":
        host = _ssh_host(parts)
        if host:
            options.append(("host", f"ssh {host}"))
    elif program in ("aws", "gh") and len(parts) >= 3:
        options.append(("service+verb", " ".join(parts[:3])))
        options.append(("service", " ".join(parts[:2])))
    elif len(parts) >= 2:
        options.append(("subcommand", " ".join(parts[:2])))
    exact = " ".join(parts)
    if not any(p == exact for _, p in options):
        options.append(("exact", exact))
    return options


def pattern_matches(parts, stored):
    """True if any of parts' available patterns equals the stored pattern."""
    return any(p == stored for _, p in pattern_options(parts))


def check_approval(safehouse_pid, cred_key, parts):
    """Check if pre-approved. Returns (approved, reason).

    `parts` is the tokenized argv list (used for read/pattern classification)."""
    key = (safehouse_pid, cred_key)
    if safehouse_pid is None or key not in approvals:
        return False, None
    entry = approvals[key]

    # Check expiry
    if entry["expires"] is not None:
        remaining = (entry["expires"] - datetime.now()).total_seconds()
        if remaining <= 0:
            del approvals[key]
            save_approvals()
            return False, None
        mins, secs = divmod(int(remaining), 60)
        time_left = f"{mins}m{secs:02d}s"
    elif isinstance(safehouse_pid, int):
        try:
            os.kill(safehouse_pid, 0)
            time_left = "sess"
        except ProcessLookupError:
            del approvals[key]
            save_approvals()
            return False, None
    else:
        # Remote scope (string identity): no live PID to probe.
        # A session approval lasts until this server process restarts.
        time_left = "sess"

    mode = entry.get("mode", "all")

    if mode == "all":
        return True, time_left

    is_read = is_read_only(parts)

    if mode == "read":
        if is_read:
            return True, f"read {time_left}"
        return False, None

    if mode == "similar":
        stored = entry.get("pattern")
        if stored and pattern_matches(parts, stored):
            return True, f"{stored} {time_left}"
        return False, None

    return False, None


def store_approval(safehouse_pid, cred_key, mode, duration, pattern=None, sensitive=False):
    """Store approval decision. mode: read/similar/all, duration: 1/5/session.

    safehouse_pid is an int (local sandbox) or a "remote:<host>" string
    (remote mode) — both are valid scope identities. duration "session"
    leaves expires=None; for an int that means until the process exits, for
    a remote string until the server restarts (see check_approval)."""
    if safehouse_pid is None:
        return
    key = (safehouse_pid, cred_key)
    durations = {"1": timedelta(minutes=1), "5": timedelta(minutes=5)}
    expires = datetime.now() + durations[duration] if duration in durations else None
    entry = {"mode": mode, "expires": expires}
    if mode == "similar" and pattern:
        entry["pattern"] = pattern
    if sensitive:
        entry["sensitive"] = True
    approvals[key] = entry
    save_approvals()


def save_approvals():
    """Persist current approvals to .approvals.toml."""
    entries = []
    now = datetime.now()
    for (pid, cred_key), entry in list(approvals.items()):
        # Remote scopes (string identity) are session-only — never persisted.
        if not isinstance(pid, int):
            continue
        # Skip already-expired entries
        if entry["expires"] is not None and entry["expires"] <= now:
            continue
        rec = {"safehouse_pid": pid, "cred_key": cred_key, "mode": entry["mode"]}
        if entry["expires"] is not None:
            rec["expires"] = entry["expires"].strftime("%Y-%m-%dT%H:%M:%S")
        if "pattern" in entry:
            rec["pattern"] = entry["pattern"]
        if entry.get("sensitive"):
            rec["sensitive"] = True
        entries.append(rec)
    lines = ["# Auto-managed by credential-server. Edit at your own risk.", ""]
    for rec in entries:
        lines.append("[[approvals]]")
        for k, v in rec.items():
            if isinstance(v, bool):
                lines.append(f"{k} = {str(v).lower()}")
            elif isinstance(v, int):
                lines.append(f"{k} = {v}")
            else:
                lines.append(f'{k} = "{v}"')
        lines.append("")
    try:
        with open(APPROVALS_PATH, "w") as f:
            f.write("\n".join(lines))
    except OSError as e:
        print(f"  {RED}warning: failed to save approvals: {e}{RESET}")


def load_approvals():
    """Load approvals from .approvals.toml. Prunes expired and dead-PID entries."""
    if tomllib is None or not os.path.exists(APPROVALS_PATH):
        return {}
    try:
        with open(APPROVALS_PATH, "rb") as f:
            data = tomllib.load(f)
    except (tomllib.TOMLDecodeError, OSError) as e:
        print(f"  {RED}warning: failed to load approvals: {e}{RESET}")
        return {}
    now = datetime.now()
    result = {}
    for rec in data.get("approvals", []):
        pid = rec.get("safehouse_pid")
        cred_key = rec.get("cred_key")
        if not pid or not cred_key:
            continue
        # Only int safehouse PIDs persist; reject any hand-edited string scope.
        if not isinstance(pid, int):
            continue
        # Check PID still alive
        if not _pid_alive(pid):
            continue
        # Check expiry
        expires = None
        if "expires" in rec:
            try:
                expires = datetime.strptime(rec["expires"], "%Y-%m-%dT%H:%M:%S")
            except ValueError:
                continue
            if expires <= now:
                continue
        entry = {"mode": rec.get("mode", "all"), "expires": expires}
        if "pattern" in rec:
            entry["pattern"] = rec["pattern"]
        if rec.get("sensitive"):
            entry["sensitive"] = True
        result[(pid, cred_key)] = entry
    return result

def read_key(timeout=None):
    """Read a single keypress without requiring Enter. Returns None on timeout."""
    fd = sys.stdin.fileno()
    if os.isatty(fd):
        old = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            if timeout is not None:
                ready, _, _ = select.select([fd], [], [], timeout)
                if not ready:
                    return None
            ch = sys.stdin.read(1)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        return ch
    else:
        # Fallback for non-TTY (testing)
        line = sys.stdin.readline()
        return line[0] if line else "d"


def _print_chain_debug(chain):
    """Print process chain for debugging approval decisions."""
    print(f"  {DIM}--- process chain (child -> parent) ---{RESET}")
    for i, (pid, name, args, _argv) in enumerate(chain):
        # Tag known process types
        tags = []
        if name == "claude":
            tags.append(f"{CYAN}claude-code{RESET}")
        elif name == "opencode":
            tags.append(f"{CYAN}opencode{RESET}")
        elif "safehouse" in args:
            tags.append(f"{GREEN}sandbox{RESET}")
        elif name == "git" or args.split()[0].endswith("/git"):
            tags.append("git")
        elif name in ("node", "python3", "bash", "zsh", "sh"):
            tags.append(name)
        for wrapper in ("bin/gh", "bin/aws", "bin/ssh", "bin/docker"):
            if wrapper in args:
                tags.append(f"{CYAN}wrapper{RESET}")
                break
        tag_str = f" {DIM}({', '.join(tags)}){RESET}" if tags else ""
        indent = "    " + "  " * i
        # Truncate long args
        display_args = args if len(args) <= 120 else args[:117] + "..."
        print(f"{indent}{DIM}pid={pid}{RESET} {BOLD}{name}{RESET}{tag_str}")
        print(f"{indent}  {DIM}{display_args}{RESET}")
    print(f"  {DIM}---{RESET}")


def _radio(segments):
    """Join [(key, label, active)] into a row, active option green, rest dim."""
    out = []
    for key, label, active in segments:
        if active:
            out.append(f"{DIM}[{key}]{RESET} {GREEN}{BOLD}{label}{RESET}")
        else:
            out.append(f"{DIM}[{key}] {label}{RESET}")
    return "  ".join(out)


def _visible_len(s):
    """Length of s ignoring ANSI escape sequences."""
    return len(re.sub(r"\x1b\[[0-9;]*m", "", s))


def _truncate_visible(s, width):
    """Truncate s to width visible columns, preserving ANSI codes and appending RESET."""
    if _visible_len(s) <= width:
        return s
    out, seen = [], 0
    for tok in re.split(r"(\x1b\[[0-9;]*m)", s):
        if tok.startswith("\x1b"):
            out.append(tok)
            continue
        for ch in tok:
            if seen >= width:
                return "".join(out) + RESET
            out.append(ch)
            seen += 1
    return "".join(out) + RESET


def prompt_approval(cmd, parts, chain=(), cred_label="", origin="this sandbox"):
    """Single-screen approval form. Returns (action, mode, duration, pattern, sensitive).
    action: 'once'/'deny'/'approve'
    mode: 'read'/'similar'/'all' (only for 'approve')
    duration: '1'/'5'/'session' (only for 'approve')
    pattern: chosen pattern string (only for mode='similar')
    sensitive: include sensitive commands in a persistent approval (only for 'approve')

    `cmd` is the display string (shown in notifications); `parts` is the argv
    list used for classification. `cred_label` names the credential the
    approval is keyed on (e.g. "ssh coding26", "aws my-profile"); `origin`
    names the approval's session scope.
    """
    pattern_opts = pattern_options(parts)

    scope = "once"
    duration = "5"
    pat_idx = 0
    sensitive = is_sensitive(parts)
    cred = cred_label or "these"

    def grant_summary():
        if scope == "once":
            return f"{DIM}this command only{RESET}"
        if scope == "reads":
            what = f"read-only {CYAN}{cred}{RESET}{DIM} commands"
        elif scope == "pattern":
            what = f"{CYAN}{cred}{RESET}{DIM} commands matching {RESET}{CYAN}{pattern_opts[pat_idx][1]}{RESET}{DIM}"
        else:
            what = f"all {CYAN}{cred}{RESET}{DIM} commands"
        dur = {"1": "for 1min", "5": "for 5min", "session": "until session ends"}[duration]
        bits = [what, origin, dur]
        if sensitive:
            bits.append("incl. sensitive")
        return f"{DIM}" + " · ".join(bits) + RESET

    def render_lines():
        persistent = scope in ("reads", "pattern", "all")
        scopes = [("o", "once"), ("r", "reads")]
        if pattern_opts:
            scopes.append(("p", "pattern"))
        scopes.append(("a", "all"))
        lines = ["  scope:    " + _radio([(k, l, scope == l) for k, l in scopes])]
        if persistent:
            lines.append("  duration: " + _radio([
                ("1", "1min", duration == "1"),
                ("5", "5min", duration == "5"),
                ("s", "session", duration == "session"),
            ]))
        if scope == "pattern" and len(pattern_opts) > 1:
            label, pat = pattern_opts[pat_idx]
            lines.append(f"  pattern:  {DIM}[g]{RESET} {label}: {CYAN}{pat}{RESET} "
                         f"{DIM}({pat_idx + 1}/{len(pattern_opts)}){RESET}")
        if persistent:
            box = f"{GREEN}[x]{RESET}" if sensitive else f"{DIM}[ ]{RESET}"
            lines.append(f"  {DIM}[t]{RESET} include sensitive {box}")
        lines.append(f"  grants:   {grant_summary()}")
        hint = f"  {DIM}[Enter] confirm  [d] deny" + ("  [?] info" if chain else "") + RESET
        lines.append(hint)
        width = shutil.get_terminal_size().columns - 1
        return [_truncate_visible(line, width) for line in lines]

    def draw(prev_n):
        # Cursor sits at the start of the last drawn line; step back to line 0.
        if prev_n > 1:
            sys.stdout.write(f"\033[{prev_n - 1}A")
        sys.stdout.write("\r\033[J")
        lines = render_lines()
        sys.stdout.write("\r\n".join(lines) + "\r")
        sys.stdout.flush()
        return len(lines)

    def confirm():
        dur_label = {"1": "1min", "5": "5min", "session": "session"}[duration]
        if scope == "reads":
            bits = ["reads", cred, dur_label]
        elif scope == "pattern":
            bits = [pattern_opts[pat_idx][1], cred, dur_label]
        elif scope == "all":
            bits = ["all", cred, dur_label]
        else:
            bits = ["once"]
        if scope != "once" and sensitive:
            bits.append("+sensitive")
        sys.stdout.write("\r\n" + f"  {GREEN}\u2713 " + " \u00b7 ".join(bits) + RESET + "\r\n")
        sys.stdout.flush()

    def deny():
        sys.stdout.write("\r\n" + f"  {RED}denied{RESET}\r\n")
        sys.stdout.flush()
        return "deny", None, None, None, False

    deadline = time.monotonic() + PROMPT_TIMEOUT
    next_reminder = time.monotonic() + REMINDER_INTERVAL
    prev_n = draw(0)
    while True:
        now = time.monotonic()
        remaining = deadline - now
        if remaining <= 0:
            sys.stdout.write("\r\n")
            print(f"  {RED}timed out{RESET}")
            return "deny", None, None, None, False
        if now >= next_reminder:
            notify(cmd)
            next_reminder = now + REMINDER_INTERVAL
        wait = min(remaining, next_reminder - now)
        ch = read_key(timeout=max(0.1, wait))
        if ch is None:
            continue
        if ch == "\x03":  # Ctrl+C
            sys.stdout.write("\r\n")
            cleanup()
        elif ch == "\x1b" or ch in ("d", "D"):
            return deny()
        elif ch == "?" and chain:
            sys.stdout.write("\r\n")
            _print_chain_debug(chain)
            prev_n = draw(0)
            continue
        elif ch in ("\r", "\n"):
            confirm()
            if scope == "once":
                return "once", None, None, None, False
            if scope == "reads":
                return "approve", "read", duration, None, sensitive
            if scope == "pattern":
                return "approve", "similar", duration, pattern_opts[pat_idx][1], sensitive
            return "approve", "all", duration, None, sensitive
        elif ch in ("o", "O"):
            scope = "once"
        elif ch in ("r", "R"):
            scope = "reads"
        elif ch in ("p", "P") and pattern_opts:
            scope = "pattern"
        elif ch in ("a", "A"):
            scope = "all"
        elif ch == "1":
            duration = "1"
        elif ch == "5":
            duration = "5"
        elif ch in ("s", "S"):
            duration = "session"
        elif ch in ("g", "G") and scope == "pattern" and len(pattern_opts) > 1:
            pat_idx = (pat_idx + 1) % len(pattern_opts)
        elif ch in ("t", "T") and scope in ("reads", "pattern", "all"):
            sensitive = not sensitive
        else:
            continue
        prev_n = draw(prev_n)


def prompt_open(cmd):
    """Prompt for a remote URL open. Returns True to open."""
    sys.stdout.write(f"  {DIM}[Enter]{RESET}open  {DIM}[d]{RESET}eny ▸ ")
    sys.stdout.flush()
    deadline = time.monotonic() + PROMPT_TIMEOUT
    next_reminder = time.monotonic() + REMINDER_INTERVAL
    while True:
        now = time.monotonic()
        remaining = deadline - now
        if remaining <= 0:
            print(f"{RED}timed out{RESET}")
            return False
        if now >= next_reminder:
            notify(cmd)
            next_reminder = now + REMINDER_INTERVAL
        wait = min(remaining, next_reminder - time.monotonic())
        ch = read_key(timeout=max(0.1, wait))
        if ch is None:
            continue
        if ch == "\x03":
            print()
            cleanup()
        elif ch == "\x1b" or ch in ("d", "D"):
            print(f"{RED}denied{RESET}")
            return False
        elif ch in ("\r", "\n"):
            print(f"{GREEN}open{RESET}")
            return True


def prompt_sensitive(cmd=None):
    """Prompt for sensitive command escalation. Returns 'once'/'deny'/'remember'."""
    sys.stdout.write(f"  {DIM}[Enter]{RESET}once  {DIM}[d]{RESET}eny  {DIM}[r]{RESET}emember ▸ ")
    sys.stdout.flush()
    deadline = time.monotonic() + PROMPT_TIMEOUT
    next_reminder = time.monotonic() + REMINDER_INTERVAL
    while True:
        now = time.monotonic()
        remaining = deadline - now
        if remaining <= 0:
            print(f"{RED}timed out{RESET}")
            return "deny"
        if now >= next_reminder:
            if cmd:
                notify(cmd)
            next_reminder = now + REMINDER_INTERVAL
        wait = min(remaining, next_reminder - time.monotonic())
        ch = read_key(timeout=max(0.1, wait))
        if ch is None:
            continue
        if ch == "\x03":
            print()
            cleanup()
        elif ch == "\x1b" or ch in ("d", "D"):
            print(f"{RED}denied{RESET}")
            return "deny"
        elif ch in ("\r", "\n"):
            print(f"{GREEN}once{RESET}")
            return "once"
        elif ch in ("r", "R"):
            print(f"{GREEN}remember{RESET}")
            return "remember"


def fetch_gh_token():
