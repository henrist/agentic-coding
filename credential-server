    print(f"auto-approved AWS profiles: {', '.join(sorted(auto_approve_aws_profiles))}")
print("Press Ctrl+C to stop\n")

# Set terminal window title for AXRaise targeting
sys.stdout.write(f"\033]0;{WINDOW_TITLE}\007")
sys.stdout.flush()

try:
    while True:
        conn, _ = sock.accept()
        try:
            # Read request
            data = conn.recv(4096).decode().strip()
            if not data:
                conn.sendall(json.dumps({"ok": False}).encode() + b"\n")
                continue
            request = json.loads(data)

            # Get process info
            peer_pid = struct.unpack("i", conn.getsockopt(SOL_LOCAL, LOCAL_PEERPID, 4))[0]
            chain = get_process_chain(peer_pid)
            cmd, cmd_pid, safehouse_pid, safehouse_cwd, actual_cmd = parse_chain(chain)
            cmd = cmd or request.get("type", "unknown")

            # Handle
            response = handle_request(conn, request, safehouse_pid, safehouse_cwd, cmd, cmd_pid, chain, actual_cmd)
            conn.sendall(json.dumps(response).encode() + b"\n")

        except (json.JSONDecodeError, EOFError, OSError):
            try:
                conn.sendall(json.dumps({"ok": False}).encode() + b"\n")
            except OSError:
                pass
        except Exception as e:
            import traceback
            print(f"\n  {RED}error: {e}{RESET}")
            traceback.print_exc()
            try:
                conn.sendall(json.dumps({"ok": False}).encode() + b"\n")
            except OSError:
                pass
        finally:
            conn.close()
finally:
    cleanup()
