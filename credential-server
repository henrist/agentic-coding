def audit_log(cmd, cred_key, approval, cwd=None, origin=None):
    """Append approved credential request to audit log.

    origin is set for remote requests ("remote:<host>") so self-reported
    remote commands are distinguishable from verified local ones."""
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    cwd_tag = f" cwd={cwd}" if cwd else ""
    origin_tag = f" origin={origin}" if origin else ""
    with open(AUDIT_LOG, "a") as f:
        f.write(f"{ts} {approval} {cred_key} {cmd}{cwd_tag}{origin_tag}\n")


