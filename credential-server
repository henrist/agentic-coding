# AWS credential cache: {profile: {"creds": {...}, "expires": datetime}}
aws_cache = {}


EXPIRED_MARKERS = ("sso session", "token has expired", "sso login")


def fetch_aws_credentials(profile, quiet=False):
    """Fetch temporary AWS credentials for profile, with caching.
    Returns (status, creds) with status in ("ok", "expired", "error")."""
    # Check cache
    if profile in aws_cache:
        entry = aws_cache[profile]
        remaining = (entry["expires"] - datetime.now()).total_seconds()
        # Use cache if >60s remaining
        if remaining > 60:
            return "ok", entry["creds"]
        del aws_cache[profile]

    try:
        result = subprocess.run(
            ["aws", "configure", "export-credentials", "--profile", profile],
            capture_output=True,
            text=True,
            check=True,
        )
        data = json.loads(result.stdout)
        creds = {
            "access_key_id": data["AccessKeyId"],
            "secret_access_key": data["SecretAccessKey"],
            "session_token": data.get("SessionToken", ""),
            "expiration": data.get("Expiration", ""),
        }
        # Cache until expiration
        if "Expiration" in data:
            expires_utc = datetime.fromisoformat(data["Expiration"].replace("Z", "+00:00"))
            expires_local = expires_utc.astimezone().replace(tzinfo=None)
            aws_cache[profile] = {"creds": creds, "expires": expires_local}
        return "ok", creds
    except subprocess.CalledProcessError as e:
        stderr = (e.stderr or "").lower()
        if any(m in stderr for m in EXPIRED_MARKERS):
            return "expired", None
        if not quiet:
            detail = (e.stderr or "").strip() or str(e)
            print(f"  {RED}error: failed to get AWS credentials for {profile}: {detail}{RESET}")
        return "error", None
    except (json.JSONDecodeError, KeyError) as e:
        if not quiet:
            print(f"  {RED}error: failed to parse AWS credentials for {profile}: {e}{RESET}")
        return "error", None


def run_aws_sso_login(profile, timeout=180):
    """Run `aws sso login --profile X` in-terminal. Returns creds dict or None."""
    cred_key = f"aws:{profile}"
    cmd_repr = f"aws sso login --profile {profile}"
    print(f"\n  {YELLOW}\u26a0 AWS session expired: {profile}{RESET}")
    print(f"  {DIM}Running: {cmd_repr}{RESET}")
    notify(f"AWS login needed: {profile}")
    audit_log(cmd_repr, cred_key, "aws-sso-login:start")

    outcome, reason, creds = "fail", None, None
    try:
        result = subprocess.run(
            ["aws", "sso", "login", "--profile", profile],
            timeout=timeout,
        )
        if result.returncode != 0:
            reason = f"SSO login exited {result.returncode}"
        else:
            status, creds = fetch_aws_credentials(profile, quiet=True)
            if creds is not None:
                outcome = "success"
            else:
                reason = f"login succeeded but credentials still unavailable ({status})"
    except subprocess.TimeoutExpired:
        outcome, reason = "timeout", "SSO login timed out"
    except OSError as e:
        reason = f"SSO login failed: {e}"

    audit_log(cmd_repr, cred_key, f"aws-sso-login:{outcome}")
    if outcome == "success":
        print(f"  {GREEN}\u2713 signed in{RESET}")
        return creds
    print(f"  {RED}\u2717 {reason}{RESET}")
    return None


def handle_request(conn, request, safehouse_pid, safehouse_cwd, cmd, cmd_argv=None, cmd_pid=None, chain=(), actual_cmd=None):
    """Handle a credential request. Returns response dict.

    `cmd` is the display string; `cmd_argv` is the canonical tokenized argv
    (passed to classifiers). When cmd_argv is None, falls back to cmd.split()."""
    global approved_pids
    req_type = request.get("type")
    is_remote = request.get("origin") == "remote"

    # Orphaned request: peer's safehouse ancestor is gone (sandbox exited while
    # request sat in the accept queue). Drop silently rather than prompting the
    # user about a dead session. Remote requests legitimately have no safehouse
    # ancestor — the main loop gives them a synthetic "remote:<host>" identity.
    if safehouse_pid is None and not is_remote:
        print(f"\n  {DIM}skipped (orphaned, no safehouse ancestor): {cmd}{RESET}")
        return {"ok": False}

    # Remote mode serves AWS and URL opens (gh/git/docker remote is out of scope).
    if is_remote and req_type not in ("aws", "open"):
        print(f"\n  {RED}remote: only aws and open supported, got {req_type}{RESET}")
        return {"ok": False}

    # URL open: http(s):// only, runs /usr/bin/open outside sandbox. Sandbox
    # opens are auto-approved; remote ones prompt, since any process on the
    # remote host can reach the forwarded socket.
    if req_type == "open":
        url = request.get("url", "")
        if not url.startswith(("http://", "https://")):
            print(f"\n  {RED}open: rejected non-http(s) URL{RESET}")
            return {"ok": False}
        if is_remote:
            host_label = safehouse_pid.split(":", 1)[1]
            port = loopback_callback_port(url)
            try:
                conn.getpeername()
            except OSError:
                print(f"  {DIM}skipped (disconnected): open{RESET}")
                return {"ok": False}
            notify(cmd)
            loc = f"{CYAN}{safehouse_cwd}{RESET}  " if safehouse_cwd else ""
            print(f"\n  {loc}{YELLOW}remote/{host_label}{RESET}")
            print(f"  {YELLOW}[remote]{RESET} {BOLD}open{RESET} {url}")
            if port:
                print(f"  {DIM}callback: tunnels localhost:{port} → {host_label}{RESET}")
            if not prompt_open(cmd):
                audit_log(f"open {url}", "open", "denied", safehouse_cwd, origin=safehouse_pid)
                return {"ok": False}
            if port:
                forward_loopback(host_label, port)
        try:
            result = subprocess.run(
                ["/usr/bin/open", url],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
                timeout=5,
            )
            if result.returncode != 0:
                print(f"\n  {RED}open failed: {result.stderr.decode(errors='replace').strip()}{RESET}")
                return {"ok": False}
        except (subprocess.TimeoutExpired, OSError) as e:
            print(f"\n  {RED}open failed: {e}{RESET}")
            return {"ok": False}
        cwd_short = os.path.basename(safehouse_cwd) if safehouse_cwd else ""
        tags = ["open"] + (["remote"] if is_remote else []) + ([cwd_short] if cwd_short else [])
        display_url = url if len(url) <= 100 else url[:97] + "..."
        print(f"\n  {GREEN}✓{RESET} {DIM}({', '.join(tags)}){RESET}\n    open {display_url}")
        audit_log(f"open {url}", "open", "once" if is_remote else "auto-open",
                  safehouse_cwd, origin=safehouse_pid if is_remote else None)
        return {"ok": True}

    # For remote requests safehouse_pid is the "remote:<host>" scope string.
    audit_origin = safehouse_pid if is_remote else None

    cmd_parts = list(cmd_argv) if cmd_argv is not None else (cmd.split() if cmd else [])
    cmd_cwd = get_cwd(cmd_pid) if cmd_pid else None
    effective_cwd = cmd_cwd or safehouse_cwd
    target_cwd = git_target_cwd(cmd_parts, effective_cwd)

    display_cwd = target_cwd or safehouse_cwd
    if is_remote:
        host_label = safehouse_pid.split(":", 1)[1]
        loc = f"{CYAN}{display_cwd}{RESET}  " if display_cwd else ""
        session_label = f"{loc}{YELLOW}remote/{host_label}{RESET}"
    elif display_cwd:
        session_label = f"{CYAN}{display_cwd}{RESET}  {DIM}safehouse/{safehouse_pid}{RESET}"
    else:
        session_label = f"safehouse/{safehouse_pid}"

    git_branch = None
    if req_type == "gh":
        cred_key = "gh"
        detail = ""
    elif req_type == "aws":
        profile = request.get("profile", "default")
        cred_key = f"aws:{profile}"
        detail = f"\n  profile: {CYAN}{profile}{RESET}"
    elif req_type == "az":
        cred_key = "az"
        detail = ""
    elif req_type == "ssh":
        ssh_host = _ssh_host(cmd_parts) if cmd_parts[:1] == ["ssh"] else None
        cred_key = f"ssh:{ssh_host}" if ssh_host else "ssh"
        detail = ""
    elif req_type == "docker":
        cred_key = "docker"
        detail = ""
    elif req_type == "netrc":
        machine = request.get("machine", "")
        cred_key = f"netrc:{machine}"
        detail = f"\n  machine: {CYAN}{machine}{RESET}"
    else:
        return {"ok": False}

    # Resolve git branch for git/gh commands (any credential type)
    if cmd_parts and (cmd_parts[0] in ("git", "gh") or cmd_parts[0].endswith("/git")):
        git_branch = get_git_branch(target_cwd)
        if git_branch:
            detail = f"\n  branch: {CYAN}{git_branch}{RESET}"

    # Check pre-approval
    key = (safehouse_pid, cred_key)
    approved, reason = check_approval(safehouse_pid, cred_key, cmd_parts)
    if approved:
        # Sensitive commands need additional escalation even when auto-approved
        if is_sensitive(cmd_parts) and not approvals.get(key, {}).get("sensitive"):
            try:
                conn.getpeername()
            except OSError:
                print(f"  {DIM}skipped (disconnected): {cmd}{RESET}")
                return {"ok": False}
            notify(cmd)
            print(f"\n  {session_label}{detail}")
            print(f"  {BOLD}⚠ sensitive:{RESET} {RED}{cmd}{RESET}")
            print(f"  {DIM}approved: {reason}{RESET}")
            sensitive_choice = prompt_sensitive(cmd)
            if sensitive_choice == "deny":
                audit_log(cmd, cred_key, "sensitive:denied", safehouse_cwd, origin=audit_origin)
                return {"ok": False}
            if sensitive_choice == "remember" and key in approvals:
                approvals[key]["sensitive"] = True
                save_approvals()
            audit_log(cmd, cred_key, f"sensitive:{sensitive_choice}", safehouse_cwd, origin=audit_origin)
        else:
            tags = [reason]
            if is_remote:
                tags.append("remote")
            if is_sensitive(cmd_parts):
                tags.append("sensitive")
            if is_read_only(cmd_parts):
                tags.append("read")
            if req_type == "aws":
                tags.insert(0, request.get("profile", "default"))
            if git_branch:
                tags.append(f"branch:{git_branch}")
            cwd_short = os.path.basename(safehouse_cwd) if safehouse_cwd else ""
            if cwd_short:
                tags.append(cwd_short)
            display = f"{actual_cmd}\n    {DIM}via: {cmd}{RESET}" if actual_cmd else cmd
            print(f"\n  {GREEN}\u2713{RESET} {DIM}({', '.join(tags)}){RESET}\n    {display}")
            audit_log(cmd, cred_key, reason, safehouse_cwd, origin=audit_origin)
        creds = _fetch_creds(req_type, request)
        if creds is not None:
            return {"ok": True, **creds}
        return {"ok": False}


    # Auto-approve git/gh reads and safe pushes
    auto_reason = None
    if auto_approve_git_reads and is_git_gh_read(cmd_parts):
        auto_reason = "read"
    elif cmd_parts[:3] == ["gh", "auth", "token"] and is_claude_code(chain):
        auto_reason = "claude-auth"
    # ssh -T to git hosts from Claude Code (connectivity probe)
    elif (auto_approve_git_reads and cmd_parts and cmd_parts[0] == "ssh"
          and "-T" in cmd_parts and _ssh_targets_git_host(cmd_parts)
          and is_claude_code(chain)):
        auto_reason = "claude-ssh"
    elif auto_approve_git_push and is_safe_git_push(cmd_parts, effective_cwd):
        auto_reason = "push"
    elif auto_approve_docker_reads and cmd_parts and cmd_parts[0] == "docker" and is_read_only(cmd_parts):
        auto_reason = "read"
    elif auto_approve_docker_reads and is_safe_docker_write(cmd_parts):
        auto_reason = "safe-run"
    elif auto_approve_netrc and req_type == "netrc":
        auto_reason = "netrc"

    # Check if any ancestor process was already approved
    if auto_reason is None and approved_pids:
        chain_pids = {pid for pid, _, _, _ in chain}
        matched = chain_pids & approved_pids
        if matched:
            # Clean up dead PIDs while we're here
            approved_pids -= {p for p in matched if not _pid_alive(p)}
            if chain_pids & approved_pids:
                auto_reason = "child"

    if auto_reason:
        creds = _fetch_creds(req_type, request)
        if creds is not None:
            if cmd_pid:
                approved_pids.add(cmd_pid)
            tag = f"auto, {auto_reason}, branch:{git_branch}" if git_branch else f"auto, {auto_reason}"
            display = f"{actual_cmd}\n    {DIM}via: {cmd}{RESET}" if actual_cmd else cmd
            print(f"\n  {GREEN}\u2713{RESET} {DIM}({tag}){RESET}\n    {display}")
            audit_log(cmd, cred_key, f"auto-{auto_reason}", safehouse_cwd, origin=audit_origin)
            return {"ok": True, **creds}

    # Auto-approve configured AWS profiles
    if req_type == "aws":
        profile = request.get("profile", "default")
        if profile in auto_approve_aws_profiles:
            creds = _fetch_creds(req_type, request)
            if creds is not None:
                tag = f"auto, config, {profile}, remote" if is_remote else f"auto, config, {profile}"
                print(f"\n  {GREEN}\u2713{RESET} {DIM}({tag}){RESET}\n    {cmd}")
                audit_log(cmd, cred_key, "auto-config", safehouse_cwd, origin=audit_origin)
                return {"ok": True, **creds}

    # Skip if caller already disconnected (queued requests)
    try:
        conn.getpeername()
    except OSError:
        print(f"  {DIM}skipped (disconnected): {cmd}{RESET}")
        return {"ok": False}

    notify(cmd)
    is_read = is_read_only(cmd_parts)
    if is_read:
        cmd_display = f"{BOLD}{cmd}{RESET} {DIM}(read){RESET}"
    else:
        cmd_display = f"{RED}{BOLD}{cmd}{RESET} {DIM}(write){RESET}"
    print(f"\n  {session_label}")
    remote_tag = f"{YELLOW}[remote]{RESET} " if is_remote else ""
    print(f"  {remote_tag}{cmd_display}{detail}")
    cred_label = cred_key.replace(":", " ", 1)
    origin = f"any session on {host_label}" if is_remote else "this sandbox"
    action, mode, duration, chosen_pattern, sensitive = prompt_approval(
        cmd, cmd_parts, chain, cred_label=cred_label, origin=origin)

    if action == "deny":
        return {"ok": False}

    creds = _fetch_creds(req_type, request)
    if creds is None:
        return {"ok": False}

    if action == "approve":
        store_approval(safehouse_pid, cred_key, mode, duration, chosen_pattern, sensitive)

    if cmd_pid:
        approved_pids.add(cmd_pid)

    audit_log(cmd, cred_key, f"{action}:{mode}:{duration}" if mode else action, safehouse_cwd, origin=audit_origin)
    return {"ok": True, **creds}


def _fetch_creds(req_type, request):
    """Fetch credentials based on request type."""
    if req_type == "gh":
        token = fetch_gh_token()
        return {"token": token} if token else None
    elif req_type == "aws":
        profile = request.get("profile", "default")
        status, creds = fetch_aws_credentials(profile)
        if creds is None and status == "expired":
            creds = run_aws_sso_login(profile)
        return creds
    elif req_type == "az":
        return {}
    elif req_type == "ssh":
        return {}
    elif req_type == "docker":
        return {}  # approval-only, access gated by proxy
    elif req_type == "netrc":
        return _fetch_netrc(request.get("machine", ""))
    return None


def _fetch_netrc(machine):
    """Read credentials for machine from ~/.netrc."""
    try:
        nrc = netrc_mod.netrc()
        auth = nrc.authenticators(machine)
        if auth:
            login, _, password = auth
            return {"login": login or "", "password": password or ""}
    except (FileNotFoundError, netrc_mod.NetrcParseError) as e:
        print(f"  {RED}netrc error: {e}{RESET}")
    return None


def _detect_docker_socket():
    """Find the real Docker socket. Returns path or None."""
    docker_host = os.environ.get("DOCKER_HOST", "")
    if docker_host.startswith("unix://"):
        path = docker_host[len("unix://"):]
        if os.path.exists(path):
            return path
    for path in [
        "/var/run/docker.sock",
        os.path.expanduser("~/.docker/run/docker.sock"),
        os.path.expanduser("~/.colima/default/docker.sock"),
        os.path.expanduser("~/.orbstack/run/docker.sock"),
    ]:
        if os.path.exists(path):
            return path
    return None


def _docker_proxy_conn(client, docker_sock_path):
    """Proxy a single connection to the real Docker socket."""
    docker = None
    try:
        peer_pid = struct.unpack("i", client.getsockopt(SOL_LOCAL, LOCAL_PEERPID, 4))[0]
        chain = get_process_chain(peer_pid)
        chain_pids = {pid for pid, _, _, _ in chain}

        if not (chain_pids & approved_pids):
            return

        docker = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        docker.connect(docker_sock_path)

        def forward(src, dst):
            try:
                while True:
                    data = src.recv(65536)
                    if not data:
                        break
                    dst.sendall(data)
            except OSError:
                pass
            try:
                dst.shutdown(socket.SHUT_WR)
            except OSError:
                pass

        t1 = threading.Thread(target=forward, args=(client, docker), daemon=True)
        t2 = threading.Thread(target=forward, args=(docker, client), daemon=True)
        t1.start()
        t2.start()
        t1.join()
        t2.join()
    except OSError:
        pass
    finally:
        try:
            client.close()
        except OSError:
            pass
        if docker:
            try:
                docker.close()
            except OSError:
                pass


def _docker_proxy_listener(proxy_sock, docker_sock_path):
    """Accept and proxy Docker connections in a loop."""
    while True:
        try:
            client, _ = proxy_sock.accept()
            threading.Thread(
                target=_docker_proxy_conn,
                args=(client, docker_sock_path),
                daemon=True,
            ).start()
        except OSError:
            break


