        else:
            exp = "session"
        print(f"  pid={pid} {cred_key} {mode} {exp}")
    sys.stdout.write(f"restore these? {DIM}[Enter]{RESET}yes  {DIM}[r]{RESET}eset \u25b8 ")
    sys.stdout.flush()
    ch = read_key()
    if ch in ("r", "R"):
