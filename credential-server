#!/usr/bin/env python3
"""Credential server for CLI tools inside safehouse sandbox.

Listens on a Unix socket and serves credentials on-demand with approval.
Supports GitHub CLI (gh) and AWS CLI.
Run this OUTSIDE the sandbox.

Protocol (JSON over Unix socket):
  Request:  {"type": "gh"}
  Request:  {"type": "aws", "profile": "my-profile"}
  Request:  {"type": "az"}
  Response: {"ok": true, ...credentials...}
  Response: {"ok": false}

Two-keypress approval:
  Step 1 - mode:
    [Enter]  once     - allow this single request
    [d/Esc]  deny     - reject this request
    [r]      reads    - auto-approve read-only commands
    [p]      pattern  - auto-approve reads + writes matching command pattern
                        (only shown for write commands, shows actual pattern)
    [a]      all      - auto-approve everything
  Step 2 - duration (for r/p/a):
    [1]  1 minute
    [5]  5 minutes
    [s]  session (until sandbox exits)
"""
import json
import os
import shutil
import signal
import socket
import struct
import subprocess
import sys
import termios
import threading
import tty
from datetime import datetime, timedelta

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
SOCKET_PATH = os.path.join(SCRIPT_DIR, ".credential-server.sock")
AUDIT_LOG = os.path.join(SCRIPT_DIR, "credential-audit.log")

# Click-to-focus notifications via alerter (brew install vjeantet/tap/alerter)
# --sender makes clicking the notification activate the sender app
TERMINAL_BUNDLE_IDS = {
    "Apple_Terminal": "com.apple.Terminal",
    "iTerm.app": "com.googlecode.iterm2",
    "ghostty": "com.mitchellh.ghostty",
    "WezTerm": "com.github.wez.wezterm",
    "Alacritty": "org.alacritty",
    "kitty": "net.kovidgoyal.kitty",
}
TERMINAL_BUNDLE_ID = TERMINAL_BUNDLE_IDS.get(os.environ.get("TERM_PROGRAM", ""))
HAS_ALERTER = shutil.which("alerter") is not None

# Approval memory: {(safehouse_pid, cred_key): {"mode": ..., "expires": ..., "pattern": ...}}
# cred_key examples: "gh", "aws:go-dev-op"
# mode: "read" = reads only, "similar" = reads + matching pattern writes, "all" = everything
# pattern: cmd_pattern string (only for "similar" mode), e.g. "aws s3 cp"
# expires: datetime | None (None = until safehouse process exits)
approvals = {}

def audit_log(cmd, cred_key, approval, cwd=None):
    """Append approved credential request to audit log."""
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    cwd_tag = f" cwd={cwd}" if cwd else ""
    with open(AUDIT_LOG, "a") as f:
        f.write(f"{ts} {approval} {cred_key} {cmd}{cwd_tag}\n")


SOL_LOCAL = 0
LOCAL_PEERPID = 2

DIM = "\033[2m"
BOLD = "\033[1m"
GREEN = "\033[32m"
RED = "\033[31m"
CYAN = "\033[36m"
RESET = "\033[0m"


def is_read_only(cmd):
    """Classify if command is read-only (safe to auto-approve in read mode)."""
    if not cmd:
        return False
    
    parts = cmd.split()
    if not parts:
        return False
    
    # AWS read prefixes
    aws_read_prefixes = ("describe-", "list-", "get-", "head-", "batch-get-")
    if parts[0] == "aws":
        for prefix in aws_read_prefixes:
            if any(part.startswith(prefix) for part in parts[1:]):
                return True
        return False
    
    gh_read_verbs = {"list", "view", "status", "diff", "checks"}
    if parts[0] == "gh":
        if len(parts) > 1 and parts[1] in gh_read_verbs:
            return True
        if len(parts) > 2 and parts[2] in gh_read_verbs:
            return True
        # gh api without -X POST/PUT/PATCH/DELETE is a GET (read)
        if len(parts) > 1 and parts[1] == "api":
            mutating = {"-X", "--method"}
            for i, p in enumerate(parts[2:], 2):
                if p in mutating and i + 1 < len(parts) and parts[i + 1].upper() != "GET":
                    return False
            return True
        return False
    
    az_read_verbs = {"list", "show", "get"}
    if parts[0] == "az":
        return any(part in az_read_verbs for part in parts[1:])
    
    return False


def notify(message):
    """Send macOS notification with sound. Click focuses terminal if alerter available."""
    def _alerter():
        """Run alerter, focus terminal on click."""
        try:
            result = subprocess.run(
                ["alerter", "--title", "Credential Request",
                 "--message", message, "--group", "credential-server",
                 "--timeout", "30"],
                capture_output=True, text=True,
            )
            if result.stdout.strip() in ("@CONTENTCLICKED", "@ACTIONCLICKED"):
                subprocess.Popen(["open", "-b", TERMINAL_BUNDLE_ID])
        except OSError:
            pass

    try:
        subprocess.Popen(
            ["afplay", "/System/Library/Sounds/Funk.aiff"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        if HAS_ALERTER and TERMINAL_BUNDLE_ID:
            threading.Thread(target=_alerter, daemon=True).start()
        else:
            subprocess.Popen(
                ["osascript",
                 "-e", f'display notification "{message}" with title "Credential Request"'],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
    except OSError:
        pass


def cleanup(*_):
    try:
        os.unlink(SOCKET_PATH)
    except OSError:
        pass
    sys.exit(0)


signal.signal(signal.SIGINT, cleanup)
signal.signal(signal.SIGTERM, cleanup)


def get_process_chain(pid, max_depth=8):
    """Walk the process tree up from pid."""
    chain = []
    current = pid
    for _ in range(max_depth):
        if current <= 1:
            break
        try:
            out = subprocess.check_output(
                ["ps", "-p", str(current), "-o", "pid=,ppid=,comm=,args="],
                stderr=subprocess.DEVNULL,
            ).decode().strip()
            parts = out.split(None, 3)
            if len(parts) < 4:
                break
            chain.append((int(parts[0]), os.path.basename(parts[2]), parts[3]))
            current = int(parts[1])
        except (subprocess.CalledProcessError, ValueError):
            break
    return chain


def get_cwd(pid):
    """Get working directory of a process."""
    try:
        out = subprocess.check_output(
            ["lsof", "-a", "-d", "cwd", "-p", str(pid), "-Fn"],
            stderr=subprocess.DEVNULL,
        ).decode()
        return next((l[1:] for l in out.splitlines() if l.startswith("n/")), None)
    except subprocess.CalledProcessError:
        return None


def parse_chain(chain):
    """Extract command and safehouse info from process chain."""
    cmd = None
    safehouse_pid = None
    safehouse_cwd = None
    for pid, name, args in chain:
        if ".credential-server.sock" in args:
            continue
        if "safehouse" in args:
            safehouse_pid = pid
            safehouse_cwd = get_cwd(pid)
            break
        # First non-skipped entry is the actual command
        if cmd is None:
            for wrapper in ("bin/gh", "bin/aws"):
                if wrapper in args:
                    parts = args.split(wrapper, 1)
                    tool = wrapper.split("/")[1]
                    cmd = f"{tool}{parts[1]}" if len(parts) > 1 else tool
                    break
            else:
                cmd = args
    if cmd:
        cmd = " ".join(cmd.split())
        if len(cmd) > 100:
            cmd = cmd[:97] + "..."
    return cmd, safehouse_pid, safehouse_cwd


def cmd_pattern(cmd):
    """Extract command pattern for grouping similar commands."""
    parts = cmd.split()
    if len(parts) >= 3 and parts[0] in ("aws", "gh"):
        return " ".join(parts[:3])
    if len(parts) >= 2:
        return " ".join(parts[:2])
    return cmd


def check_approval(safehouse_pid, cred_key, cmd):
    """Check if pre-approved. Returns (approved, reason)."""
    key = (safehouse_pid, cred_key)
    if safehouse_pid is None or key not in approvals:
        return False, None
    entry = approvals[key]

    # Check expiry
    if entry["expires"] is not None:
        remaining = (entry["expires"] - datetime.now()).total_seconds()
        if remaining <= 0:
            del approvals[key]
            return False, None
        mins, secs = divmod(int(remaining), 60)
        time_left = f"{mins}m{secs:02d}s"
    else:
        try:
            os.kill(safehouse_pid, 0)
            time_left = "sess"
        except ProcessLookupError:
            del approvals[key]
            return False, None

    mode = entry.get("mode", "all")

    if mode == "all":
        return True, time_left

    is_read = is_read_only(cmd)

    if mode == "read":
        if is_read:
            return True, f"read {time_left}"
        return False, None

    if mode == "similar":
        if is_read:
            return True, f"read {time_left}"
        if cmd_pattern(cmd) == entry.get("pattern"):
            return True, f"{entry['pattern']} {time_left}"
        return False, None

    return False, None


def store_approval(safehouse_pid, cred_key, mode, duration, cmd=None):
    """Store approval decision. mode: read/similar/all, duration: 1/5/session."""
    if safehouse_pid is None:
        return
    key = (safehouse_pid, cred_key)
    durations = {"1": timedelta(minutes=1), "5": timedelta(minutes=5)}
    expires = datetime.now() + durations[duration] if duration in durations else None
    entry = {"mode": mode, "expires": expires}
    if mode == "similar" and cmd:
        entry["pattern"] = cmd_pattern(cmd)
    approvals[key] = entry


def read_key():
    """Read a single keypress without requiring Enter."""
    fd = sys.stdin.fileno()
    if os.isatty(fd):
        old = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            ch = sys.stdin.read(1)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        return ch
    else:
        # Fallback for non-TTY (testing)
        line = sys.stdin.readline()
        return line[0] if line else "d"


def prompt_duration(mode_label):
    """Prompt for duration after mode selection. Returns '1'/'5'/'s' or None on cancel."""
    sys.stdout.write(f"  {mode_label} {DIM}[1]{RESET}min  {DIM}[5]{RESET}min  {DIM}[s]{RESET}ession ▸ ")
    sys.stdout.flush()
    while True:
        ch = read_key()
        if ch == "\x03":
            print()
            cleanup()
        elif ch == "\x1b" or ch in ("d", "D"):
            print(f"{RED}cancelled{RESET}\n")
            return None
        elif ch == "1":
            print(f"{GREEN}1 min{RESET}\n")
            return "1"
        elif ch == "5":
            print(f"{GREEN}5 min{RESET}\n")
            return "5"
        elif ch in ("s", "S"):
            print(f"{GREEN}session{RESET}\n")
            return "session"


def prompt_approval(cmd):
    """Two-step approval: mode then duration. Returns (action, mode, duration) tuple.
    action: 'once'/'deny'/'approve'
    mode: 'read'/'similar'/'all' (only for 'approve')
    duration: '1'/'5'/'session' (only for 'approve')
    """
    is_write = not is_read_only(cmd)
    pattern = cmd_pattern(cmd) if is_write else None

    if pattern:
        sys.stdout.write(f"  {DIM}[Enter]{RESET}once  {DIM}[d]{RESET}eny  {DIM}[r]{RESET}eads  {DIM}[p]{RESET} {CYAN}{pattern}{RESET}+reads  {DIM}[a]{RESET}ll ▸ ")
    else:
        sys.stdout.write(f"  {DIM}[Enter]{RESET}once  {DIM}[d]{RESET}eny  {DIM}[r]{RESET}eads  {DIM}[a]{RESET}ll ▸ ")
    sys.stdout.flush()
    while True:
        ch = read_key()
        if ch == "\x03":  # Ctrl+C
            print()
            cleanup()
        elif ch == "\x1b":  # Esc
            print(f"{RED}denied{RESET}\n")
            return "deny", None, None
        elif ch in ("d", "D"):
            print(f"{RED}denied{RESET}\n")
            return "deny", None, None
        elif ch in ("\r", "\n"):
            print(f"{GREEN}once{RESET}\n")
            return "once", None, None
        elif ch in ("r", "R"):
            sys.stdout.write(f"{GREEN}reads{RESET}\n")
            dur = prompt_duration("reads")
            if dur is None:
                return "deny", None, None
            return "approve", "read", dur
        elif ch in ("p", "P") and pattern:
            sys.stdout.write(f"{GREEN}{pattern}+reads{RESET}\n")
            dur = prompt_duration(f"{pattern}+reads")
            if dur is None:
                return "deny", None, None
            return "approve", "similar", dur
        elif ch in ("a", "A"):
            sys.stdout.write(f"{GREEN}all{RESET}\n")
            dur = prompt_duration("all")
            if dur is None:
                return "deny", None, None
            return "approve", "all", dur


def fetch_gh_token():
    """Fetch gh auth token. Returns token string or None."""
    try:
        return subprocess.check_output(
            ["gh", "auth", "token"], stderr=subprocess.DEVNULL
        ).decode().strip()
    except subprocess.CalledProcessError:
        return None


# AWS credential cache: {profile: {"creds": {...}, "expires": datetime}}
aws_cache = {}


def fetch_aws_credentials(profile):
    """Fetch temporary AWS credentials for profile, with caching. Returns dict or None."""
    # Check cache
    if profile in aws_cache:
        entry = aws_cache[profile]
        remaining = (entry["expires"] - datetime.now()).total_seconds()
        # Use cache if >60s remaining
        if remaining > 60:
            return entry["creds"]
        del aws_cache[profile]

    try:
        out = subprocess.check_output(
            ["aws", "configure", "export-credentials", "--profile", profile],
            stderr=subprocess.DEVNULL,
        ).decode()
        data = json.loads(out)
        creds = {
            "access_key_id": data["AccessKeyId"],
            "secret_access_key": data["SecretAccessKey"],
            "session_token": data.get("SessionToken", ""),
        }
        # Cache until expiration
        if "Expiration" in data:
            expires_utc = datetime.fromisoformat(data["Expiration"].replace("Z", "+00:00"))
            expires_local = expires_utc.astimezone().replace(tzinfo=None)
            aws_cache[profile] = {"creds": creds, "expires": expires_local}
        return creds
    except (subprocess.CalledProcessError, json.JSONDecodeError, KeyError) as e:
        print(f"  {RED}error: failed to get AWS credentials for {profile}: {e}{RESET}")
        return None


def handle_request(conn, request, safehouse_pid, safehouse_cwd, cmd):
    """Handle a credential request. Returns response dict."""
    req_type = request.get("type")
    cwd_label = f" {DIM}({safehouse_cwd}){RESET}" if safehouse_cwd else ""
    session_label = f"safehouse/{safehouse_pid}{cwd_label}" if safehouse_pid else "unknown"

    if req_type == "gh":
        cred_key = "gh"
        detail = ""
    elif req_type == "aws":
        profile = request.get("profile", "default")
        cred_key = f"aws:{profile}"
        detail = f"\n  profile: {CYAN}{profile}{RESET}"
    elif req_type == "az":
        cred_key = "az"
        detail = ""
    else:
        return {"ok": False}

    # Check pre-approval
    approved, reason = check_approval(safehouse_pid, cred_key, cmd)
    if approved:
        creds = _fetch_creds(req_type, request)
        if creds:
            tags = [reason]
            if req_type == "aws":
                tags.insert(0, request.get("profile", "default"))
            cwd_short = os.path.basename(safehouse_cwd) if safehouse_cwd else ""
            if cwd_short:
                tags.append(cwd_short)
            print(f"  {GREEN}✓{RESET} {cmd} {DIM}({', '.join(tags)}){RESET}")
            audit_log(cmd, cred_key, reason, safehouse_cwd)
            return {"ok": True, **creds}
        return {"ok": False}

    # Skip if caller already disconnected (queued requests)
    try:
        conn.getpeername()
    except OSError:
        print(f"  {DIM}skipped (disconnected): {cmd}{RESET}")
        return {"ok": False}

    notify(cmd)
    read_tag = f" {DIM}(read){RESET}" if is_read_only(cmd) else f" {DIM}(write){RESET}"
    print(f"\n  {BOLD}{cmd}{RESET}{read_tag}{detail}")
    print(f"  {session_label}")
    action, mode, duration = prompt_approval(cmd)

    if action == "deny":
        return {"ok": False}

    creds = _fetch_creds(req_type, request)
    if not creds:
        return {"ok": False}

    if action == "approve":
        store_approval(safehouse_pid, cred_key, mode, duration, cmd)

    audit_log(cmd, cred_key, f"{action}:{mode}:{duration}" if mode else action, safehouse_cwd)
    return {"ok": True, **creds}


def _fetch_creds(req_type, request):
    """Fetch credentials based on request type."""
    if req_type == "gh":
        token = fetch_gh_token()
        return {"token": token} if token else None
    elif req_type == "aws":
        return fetch_aws_credentials(request.get("profile", "default"))
    elif req_type == "az":
        return {}
    return None


# --- Main ---

if os.path.exists(SOCKET_PATH):
    os.unlink(SOCKET_PATH)

sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.bind(SOCKET_PATH)
os.chmod(SOCKET_PATH, 0o600)
sock.listen(5)

print("credential server listening")
print("Press Ctrl+C to stop\n")

try:
    while True:
        conn, _ = sock.accept()
        try:
            # Read request
            data = conn.recv(4096).decode().strip()
            if not data:
                conn.sendall(json.dumps({"ok": False}).encode() + b"\n")
                continue
            request = json.loads(data)

            # Get process info
            peer_pid = struct.unpack("i", conn.getsockopt(SOL_LOCAL, LOCAL_PEERPID, 4))[0]
            chain = get_process_chain(peer_pid)
            cmd, safehouse_pid, safehouse_cwd = parse_chain(chain)
            cmd = cmd or request.get("type", "unknown")

            # Handle
            response = handle_request(conn, request, safehouse_pid, safehouse_cwd, cmd)
            conn.sendall(json.dumps(response).encode() + b"\n")

        except (json.JSONDecodeError, EOFError, OSError):
            try:
                conn.sendall(json.dumps({"ok": False}).encode() + b"\n")
            except OSError:
                pass
        finally:
            conn.close()
finally:
    cleanup()
