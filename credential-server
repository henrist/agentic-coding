#!/usr/bin/env python3
"""Credential server for CLI tools inside safehouse sandbox.

Listens on a Unix socket and serves credentials on-demand with approval.
Supports GitHub CLI (gh) and AWS CLI.
Run this OUTSIDE the sandbox.

Protocol (JSON over Unix socket):
  Request:  {"type": "gh"}
  Request:  {"type": "aws", "profile": "my-profile"}
  Response: {"ok": true, ...credentials...}
  Response: {"ok": false}

Single-keypress approval:
  [d/Enter] deny     - reject this request
  [o]       once     - allow this single request
  [1]       1 min    - auto-approve for 1 min
  [5]       5 min    - auto-approve for 5 min
  [s]       session  - auto-approve until sandbox exits
  [r]       read 1min - read-only for 1 min (re-prompts mutations)
  [R]       read 5min - read-only for 5 min (re-prompts mutations)
  [e]       read session - read-only until sandbox exits (re-prompts mutations)
"""
import json
import os
import signal
import socket
import struct
import subprocess
import sys
import termios
import tty
from datetime import datetime, timedelta

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
SOCKET_PATH = os.path.join(SCRIPT_DIR, ".credential-server.sock")
AUDIT_LOG = os.path.join(SCRIPT_DIR, "credential-audit.log")

# Approval memory: {(safehouse_pid, cred_key): {"mode": "all"|"read", "expires": datetime | None, "mutation_until": datetime | None}}
# cred_key examples: "gh", "aws:go-dev-op"
# mode: "all" = all commands approved, "read" = only read commands approved
# expires: None means "until safehouse process exits"
# mutation_until: datetime for temporary mutation access during read-only mode
approvals = {}

def audit_log(cmd, cred_key, approval, cwd=None):
    """Append approved credential request to audit log."""
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    cwd_tag = f" cwd={cwd}" if cwd else ""
    with open(AUDIT_LOG, "a") as f:
        f.write(f"{ts} {approval} {cred_key} {cmd}{cwd_tag}\n")


SOL_LOCAL = 0
LOCAL_PEERPID = 2

DIM = "\033[2m"
BOLD = "\033[1m"
GREEN = "\033[32m"
RED = "\033[31m"
YELLOW = "\033[33m"
CYAN = "\033[36m"
RESET = "\033[0m"


def is_read_only(cmd):
    """Classify if command is read-only (safe to auto-approve in read mode)."""
    if not cmd:
        return False
    
    parts = cmd.split()
    if not parts:
        return False
    
    # AWS read prefixes
    aws_read_prefixes = ("describe-", "list-", "get-", "head-", "batch-get-")
    if parts[0] == "aws":
        for prefix in aws_read_prefixes:
            if any(part.startswith(prefix) for part in parts[1:]):
                return True
        return False
    
    gh_read_verbs = {"list", "view", "status", "diff", "checks"}
    if parts[0] == "gh":
        if len(parts) > 1 and parts[1] in gh_read_verbs:
            return True
        if len(parts) > 2 and parts[2] in gh_read_verbs:
            return True
        # gh api without -X POST/PUT/PATCH/DELETE is a GET (read)
        if len(parts) > 1 and parts[1] == "api":
            mutating = {"-X", "--method"}
            for i, p in enumerate(parts[2:], 2):
                if p in mutating and i + 1 < len(parts) and parts[i + 1].upper() != "GET":
                    return False
            return True
        return False
    
    return False


def cleanup(*_):
    try:
        os.unlink(SOCKET_PATH)
    except OSError:
        pass
    sys.exit(0)


signal.signal(signal.SIGINT, cleanup)
signal.signal(signal.SIGTERM, cleanup)


def get_process_chain(pid, max_depth=8):
    """Walk the process tree up from pid."""
    chain = []
    current = pid
    for _ in range(max_depth):
        if current <= 1:
            break
        try:
            out = subprocess.check_output(
                ["ps", "-p", str(current), "-o", "pid=,ppid=,comm=,args="],
                stderr=subprocess.DEVNULL,
            ).decode().strip()
            parts = out.split(None, 3)
            if len(parts) < 4:
                break
            chain.append((int(parts[0]), os.path.basename(parts[2]), parts[3]))
            current = int(parts[1])
        except (subprocess.CalledProcessError, ValueError):
            break
    return chain


def get_cwd(pid):
    """Get working directory of a process."""
    try:
        out = subprocess.check_output(
            ["lsof", "-a", "-d", "cwd", "-p", str(pid), "-Fn"],
            stderr=subprocess.DEVNULL,
        ).decode()
        return next((l[1:] for l in out.splitlines() if l.startswith("n/")), None)
    except subprocess.CalledProcessError:
        return None


def parse_chain(chain):
    """Extract command and safehouse info from process chain."""
    cmd = None
    safehouse_pid = None
    safehouse_cwd = None
    for pid, name, args in chain:
        if ".credential-server.sock" in args:
            continue
        if "safehouse" in args:
            safehouse_pid = pid
            safehouse_cwd = get_cwd(pid)
            break
        # First non-skipped entry is the actual command
        if cmd is None:
            for wrapper in ("bin/gh", "bin/aws"):
                if wrapper in args:
                    parts = args.split(wrapper, 1)
                    tool = wrapper.split("/")[1]
                    cmd = f"{tool}{parts[1]}" if len(parts) > 1 else tool
                    break
            else:
                cmd = args
    if cmd and len(cmd) > 100:
        cmd = cmd[:97] + "..."
    return cmd, safehouse_pid, safehouse_cwd


def check_approval(safehouse_pid, cred_key, cmd):
    """Check if pre-approved. Returns (approved, reason)."""
    key = (safehouse_pid, cred_key)
    if safehouse_pid is None or key not in approvals:
        return False, None
    entry = approvals[key]
    
    # Check if in read-only mode and command is a mutation
    if entry.get("mode") == "read" and not is_read_only(cmd):
        # Check if we have temporary mutation override
        mutation_until = entry.get("mutation_until")
        if mutation_until is not None:
            remaining = (mutation_until - datetime.now()).total_seconds()
            if remaining > 0:
                mins, secs = divmod(int(remaining), 60)
                return True, f"read+1m {mins}m{secs:02d}s left"
            else:
                # Mutation override expired, need re-prompt
                return False, None
        # No mutation override, need re-prompt
        return False, None
    
    if entry["expires"] is not None:
        remaining = (entry["expires"] - datetime.now()).total_seconds()
        if remaining <= 0:
            del approvals[key]
            return False, None
        mins, secs = divmod(int(remaining), 60)
        mode_tag = f"{entry.get('mode', 'all')}" if entry.get("mode") == "read" else ""
        reason = f"{mins}m{secs:02d}s left"
        if mode_tag:
            reason = f"{mode_tag} {reason}"
        return True, reason
    else:
        try:
            os.kill(safehouse_pid, 0)
            mode_tag = f"{entry.get('mode', 'all')}" if entry.get("mode") == "read" else ""
            reason = "session"
            if mode_tag:
                reason = f"{mode_tag} {reason}"
            return True, reason
        except ProcessLookupError:
            del approvals[key]
            return False, None


def store_approval(safehouse_pid, cred_key, choice):
    """Store approval decision."""
    if safehouse_pid is None:
        return
    key = (safehouse_pid, cred_key)
    if choice == "1min":
        approvals[key] = {"mode": "all", "expires": datetime.now() + timedelta(minutes=1), "mutation_until": None}
    elif choice == "5min":
        approvals[key] = {"mode": "all", "expires": datetime.now() + timedelta(minutes=5), "mutation_until": None}
    elif choice == "session":
        approvals[key] = {"mode": "all", "expires": None, "mutation_until": None}
    elif choice == "read1min":
        approvals[key] = {"mode": "read", "expires": datetime.now() + timedelta(minutes=1), "mutation_until": None}
    elif choice == "read5min":
        approvals[key] = {"mode": "read", "expires": datetime.now() + timedelta(minutes=5), "mutation_until": None}
    elif choice == "readsession":
        approvals[key] = {"mode": "read", "expires": None, "mutation_until": None}


def store_mutation_override(safehouse_pid, cred_key, choice):
    """Store temporary mutation override for read-only mode."""
    if safehouse_pid is None:
        return
    key = (safehouse_pid, cred_key)
    if key not in approvals:
        return
    entry = approvals[key]
    if choice == "1min":
        entry["mutation_until"] = datetime.now() + timedelta(minutes=1)
    elif choice == "5min":
        entry["mutation_until"] = datetime.now() + timedelta(minutes=5)


def read_key():
    """Read a single keypress without requiring Enter."""
    fd = sys.stdin.fileno()
    if os.isatty(fd):
        old = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            ch = sys.stdin.read(1)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        return ch
    else:
        # Fallback for non-TTY (testing)
        line = sys.stdin.readline()
        return line[0] if line else "d"


def prompt_approval():
    """Prompt user for approval. Returns choice string."""
    sys.stdout.write(f"  {DIM}[d]{RESET}eny  {DIM}[o]{RESET}nce  {DIM}[1]{RESET}min  {DIM}[5]{RESET}min  {DIM}[s]{RESET}ession  reads:{DIM}[r]{RESET}1m/{DIM}[R]{RESET}5m/{DIM}[e]{RESET}sess ▸ ")
    sys.stdout.flush()
    while True:
        ch = read_key()
        if ch == "\x03":  # Ctrl+C
            print()
            cleanup()
        elif ch in ("d", "D", "\r", "\n"):
            print(f"{RED}denied{RESET}\n")
            return "deny"
        elif ch in ("o", "O"):
            print(f"{GREEN}once{RESET}\n")
            return "once"
        elif ch == "1":
            print(f"{GREEN}1 min{RESET}\n")
            return "1min"
        elif ch == "5":
            print(f"{GREEN}5 min{RESET}\n")
            return "5min"
        elif ch in ("s", "S"):
            print(f"{GREEN}session{RESET}\n")
            return "session"
        elif ch in ("r",):
            print(f"{GREEN}read 1min{RESET}\n")
            return "read1min"
        elif ch in ("R",):
            print(f"{GREEN}read 5min{RESET}\n")
            return "read5min"
        elif ch in ("e", "E"):
            print(f"{GREEN}read session{RESET}\n")
            return "readsession"


def fetch_gh_token():
    """Fetch gh auth token. Returns token string or None."""
    try:
        return subprocess.check_output(
            ["gh", "auth", "token"], stderr=subprocess.DEVNULL
        ).decode().strip()
    except subprocess.CalledProcessError:
        return None


# AWS credential cache: {profile: {"creds": {...}, "expires": datetime}}
aws_cache = {}


def fetch_aws_credentials(profile):
    """Fetch temporary AWS credentials for profile, with caching. Returns dict or None."""
    # Check cache
    if profile in aws_cache:
        entry = aws_cache[profile]
        remaining = (entry["expires"] - datetime.now()).total_seconds()
        # Use cache if >60s remaining
        if remaining > 60:
            return entry["creds"]
        del aws_cache[profile]

    try:
        out = subprocess.check_output(
            ["aws", "configure", "export-credentials", "--profile", profile],
            stderr=subprocess.DEVNULL,
        ).decode()
        data = json.loads(out)
        creds = {
            "access_key_id": data["AccessKeyId"],
            "secret_access_key": data["SecretAccessKey"],
            "session_token": data.get("SessionToken", ""),
        }
        # Cache until expiration
        if "Expiration" in data:
            expires_utc = datetime.fromisoformat(data["Expiration"].replace("Z", "+00:00"))
            expires_local = expires_utc.astimezone().replace(tzinfo=None)
            aws_cache[profile] = {"creds": creds, "expires": expires_local}
        return creds
    except (subprocess.CalledProcessError, json.JSONDecodeError, KeyError) as e:
        print(f"  {RED}error: failed to get AWS credentials for {profile}: {e}{RESET}")
        return None


def handle_request(conn, request, safehouse_pid, safehouse_cwd, cmd):
    """Handle a credential request. Returns response dict."""
    req_type = request.get("type")
    cwd_label = f" {DIM}({safehouse_cwd}){RESET}" if safehouse_cwd else ""
    session_label = f"safehouse/{safehouse_pid}{cwd_label}" if safehouse_pid else "unknown"

    if req_type == "gh":
        cred_key = "gh"
        detail = ""
    elif req_type == "aws":
        profile = request.get("profile", "default")
        cred_key = f"aws:{profile}"
        detail = f"\n  profile: {CYAN}{profile}{RESET}"
    else:
        return {"ok": False}

    # Check pre-approval
    approved, reason = check_approval(safehouse_pid, cred_key, cmd)
    if approved:
        creds = _fetch_creds(req_type, request)
        if creds:
            tags = [reason]
            if req_type == "aws":
                tags.insert(0, request.get("profile", "default"))
            print(f"  {GREEN}✓{RESET} {cmd} {DIM}({', '.join(tags)}){RESET}")
            audit_log(cmd, cred_key, reason, safehouse_cwd)
            return {"ok": True, **creds}
        return {"ok": False}

    # Check if we have existing read-mode approval and need to re-prompt for mutation
    existing_read_mode = False
    if safehouse_pid and (safehouse_pid, cred_key) in approvals:
        entry = approvals[(safehouse_pid, cred_key)]
        existing_read_mode = entry.get("mode") == "read"

    # Skip if caller already disconnected (queued requests)
    try:
        conn.getpeername()
    except OSError:
        print(f"  {DIM}skipped (disconnected): {cmd}{RESET}")
        return {"ok": False}

    try:
        subprocess.Popen(
            ["osascript", "-e", f'display notification "{cmd}" with title "Credential Request"',
             "-e", 'do shell script "afplay /System/Library/Sounds/Funk.aiff"'],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass
    print(f"\n  {BOLD}{cmd}{RESET}{detail}")
    print(f"  {session_label}")
    choice = prompt_approval()

    if choice == "deny":
        return {"ok": False}

    creds = _fetch_creds(req_type, request)
    if not creds:
        return {"ok": False}

    # Handle mutation override for read-only mode
    if existing_read_mode and choice in ("1min", "5min"):
        store_mutation_override(safehouse_pid, cred_key, choice)
    elif choice != "deny" and choice != "once":
        store_approval(safehouse_pid, cred_key, choice)
    
    audit_log(cmd, cred_key, choice, safehouse_cwd)
    return {"ok": True, **creds}


def _fetch_creds(req_type, request):
    """Fetch credentials based on request type."""
    if req_type == "gh":
        token = fetch_gh_token()
        return {"token": token} if token else None
    elif req_type == "aws":
        return fetch_aws_credentials(request.get("profile", "default"))
    return None


# --- Main ---

if os.path.exists(SOCKET_PATH):
    os.unlink(SOCKET_PATH)

sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.bind(SOCKET_PATH)
os.chmod(SOCKET_PATH, 0o600)
sock.listen(5)

print("credential server listening")
print("Press Ctrl+C to stop\n")

try:
    while True:
        conn, _ = sock.accept()
        try:
            # Read request
            data = conn.recv(4096).decode().strip()
            if not data:
                conn.sendall(json.dumps({"ok": False}).encode() + b"\n")
                continue
            request = json.loads(data)

            # Get process info
            peer_pid = struct.unpack("i", conn.getsockopt(SOL_LOCAL, LOCAL_PEERPID, 4))[0]
            chain = get_process_chain(peer_pid)
            cmd, safehouse_pid, safehouse_cwd = parse_chain(chain)
            cmd = cmd or request.get("type", "unknown")

            # Handle
            response = handle_request(conn, request, safehouse_pid, safehouse_cwd, cmd)
            conn.sendall(json.dumps(response).encode() + b"\n")

        except (json.JSONDecodeError, EOFError, OSError):
            try:
                conn.sendall(json.dumps({"ok": False}).encode() + b"\n")
            except OSError:
                pass
        finally:
            conn.close()
finally:
    cleanup()
