def is_sensitive(cmd):
    """Check if command accesses sensitive services (secrets, keys, etc.)."""
    parts = cmd.split()
    return any(part in SENSITIVE_SERVICES for part in parts)


def is_read_only(cmd):
    """Classify if command is read-only (safe to auto-approve in read mode)."""
    if not cmd:
        return False

    parts = cmd.split()
    if not parts:
        return False

    aws_read_prefixes = ("describe-", "list-", "get-", "head-", "batch-get-", "filter-", "lookup-", "search-")
    aws_read_exact = {"ls", "tail", "scan", "query", "search", "start-query", "start-live-tail"}
    if parts[0] == "aws":
        if is_sensitive(cmd):
            return False
        for prefix in aws_read_prefixes:
            if any(part.startswith(prefix) for part in parts[1:]):
                return True
        if any(part in aws_read_exact for part in parts[1:]):
            return True
        return False

    gh_read_verbs = {"list", "view", "status", "diff", "checks", "search", "clone"}
    if parts[0] == "gh":
        if len(parts) > 1 and parts[1] in gh_read_verbs:
            return True
        if len(parts) > 2 and parts[2] in gh_read_verbs:
            return True
        if len(parts) > 1 and parts[1] == "api":
            mutating = {"-X", "--method"}
            for i, p in enumerate(parts[2:], 2):
                if p in mutating and i + 1 < len(parts) and parts[i + 1].upper() != "GET":
                    return False
            return True
        return False

    az_read_verbs = {"list", "show", "get"}
    if parts[0] == "az":
        if is_sensitive(cmd):
            return False
        return any(part in az_read_verbs for part in parts[1:])


    git_read_subcommands = {"fetch", "pull", "clone", "ls-remote"}
    if parts[0] == "git" or parts[0].endswith("/git"):
        # Skip -c key=value config flags to find actual subcommand
        i = 1
        while i < len(parts) - 1 and parts[i] == "-c":
            i += 2  # skip -c and its value
        return i < len(parts) and parts[i] in git_read_subcommands

    return False


def is_git_gh_read(cmd):
    """Check if command is a git or gh read operation."""
    if not cmd:
        return False
    parts = cmd.split()
    if parts and (parts[0] == "gh" or parts[0] == "git" or parts[0].endswith("/git")):
        return is_read_only(cmd)
    return False

def is_claude_code(chain):
    """Check if process chain originates from Claude Code."""
    return any(name == "claude" for _, name, _ in chain)

def get_git_branch(cwd):
    """Get current git branch name from working directory. Returns branch name or None."""
    if not cwd:
        return None
    try:
        return subprocess.check_output(
            ["git", "-C", cwd, "branch", "--show-current"],
            stderr=subprocess.DEVNULL,
        ).decode().strip() or None
    except (subprocess.CalledProcessError, OSError):
        return None


def get_gh_target_repo(parts):
    """Extract target repo from gh command. Checks -R/--repo flag, URLs, and owner/repo#N args."""
    for i, part in enumerate(parts):
        if part in ("-R", "--repo") and i + 1 < len(parts):
            return parts[i + 1]
        if part.startswith("--repo="):
            return part.split("=", 1)[1]
    # Check positional args for URL or owner/repo#N patterns
    for part in parts:
        if part.startswith("-"):
            continue
        if part.startswith("https://github.com/"):
            segments = part[len("https://github.com/"):].split("/")
            if len(segments) >= 2:
                return "/".join(segments[:2])
        if "#" in part and "/" in part.split("#")[0]:
            return part.split("#")[0]
    return None


def get_current_repo(cwd):
    """Get owner/repo from git remote origin. Returns None on failure."""
    if not cwd:
        return None
    try:
        url = subprocess.check_output(
            ["git", "-C", cwd, "remote", "get-url", "origin"],
            stderr=subprocess.DEVNULL,
        ).decode().strip()
        for prefix in ("https://github.com/", "git@github.com:"):
            if url.startswith(prefix):
                return url[len(prefix):].removesuffix(".git")
        return None
    except (subprocess.CalledProcessError, OSError):
        return None


def is_same_repo(parts, safehouse_cwd):
    """Check if gh command targets the checked-out repo. False if targeting a different repo."""
    target = get_gh_target_repo(parts)
    if target is None:
        return True
    current = get_current_repo(safehouse_cwd)
    if current is None:
        return False
    return target.lower().rstrip("/") == current.lower().rstrip("/")

def is_safe_gh_api_write(parts, safehouse_cwd):
    """Check if gh api write targets a safe endpoint (comments/reviews) on the same repo."""
    # Find API path (first non-flag arg after 'api')
    api_path = None
    for part in parts[2:]:
        if not part.startswith("-"):
            api_path = part
            break
    if not api_path:
        return False
    segments = api_path.split("/")
    # repos/owner/repo/.../comments or .../reviews
    if len(segments) < 4 or segments[0] != "repos":
        return False
    if segments[-1] not in ("comments", "reviews"):
        return False
    api_repo = "/".join(segments[1:3])
    current = get_current_repo(safehouse_cwd)
    if current is None:
        return False
    return api_repo.lower() == current.lower()

def is_safe_git_push(cmd, safehouse_cwd):
    """Check if command is a safe push/PR op (not targeting main/master). Best-effort."""
    if not cmd:
        return False
    parts = cmd.split()
    if not parts:
        return False

    protected = {"main", "master"}

    # gh pr/issue writes and run rerun (not merge)
    if parts[0] == "gh":
        if not is_same_repo(parts, safehouse_cwd):
            return False
        if len(parts) >= 3 and parts[1] == "pr" and parts[2] in ("create", "edit", "close", "comment"):
            return True
        if len(parts) >= 3 and parts[1] == "issue" and parts[2] == "comment":
            return True
        if len(parts) >= 3 and parts[1] == "run" and parts[2] == "rerun":
            return True
        if len(parts) >= 3 and parts[1] == "api":
            return is_safe_gh_api_write(parts, safehouse_cwd)
        return False

    # git push only
    if not (parts[0] == "git" or parts[0].endswith("/git")):
        return False
    # Skip -c key=value config flags to find actual subcommand
    ci = 1
    while ci < len(parts) - 1 and parts[ci] == "-c":
        ci += 2
    if ci >= len(parts) or parts[ci] != "push":
        return False

    # Don't auto-approve --all or --mirror (pushes all branches including protected)
    rest = parts[ci + 1:]
    if any(p in ("--all", "--mirror") for p in rest):
        return False

    # Parse: git push [flags...] [remote] [refspec...]
    args = [p for p in rest if not p.startswith("-")]

    # Check explicit refspecs for protected branch targets
    if len(args) >= 2:
        for refspec in args[1:]:
            if ":" in refspec:
                target = refspec.split(":")[-1].removeprefix("refs/heads/")
            else:
                target = refspec.removeprefix("refs/heads/")
            if target in protected:
                return False
            if target.upper() == "HEAD":
                break  # HEAD resolves to current branch — fall through
        else:
            return True  # All explicit refspecs are non-protected

    # No explicit branch or HEAD used - determine current branch from cwd
    branch = get_git_branch(safehouse_cwd)
    if branch:
        return branch not in protected
    return False

